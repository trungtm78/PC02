rePermissions({ action: 'read', subject: 'Case' })\n  getById(\n    @Param('id') id: string,\n    @Req() req: ScopedRequest,\n    @CurrentUser() user: AuthUser,\n  ) {\n    return this.conclusionsService.getById(id, req.dataScope, user.id);\n  }\n\n  @Post()\n  @RequirePermissions({ action: 'write', subject: 'Case' })\n  create(@Body() dto: CreateConclusionDto, @CurrentUser() user: AuthUser, @Req() req: ScopedRequest) {\n    return this.conclusionsService.create(\n      dto,\n      user.id,\n      { ipAddress: req.ip, userAgent: req.headers['user-agent'] },\n      req.dataScope,\n    );\n  }\n\n  @Put(':id')\n  @RequirePermissions({ action: 'edit', subject: 'Case' })\n  update(@Param('id') id: string, @Body() dto: Partial<CreateConclusionDto>, @CurrentUser() user: AuthUser, @Req() req: ScopedRequest) {\n    return this.conclusionsService.update(id, dto, user.id, { ipAddress: req.ip, userAgent: req.headers['user-agent'] }, req.dataScope);\n  }\n\n  @Delete(':id')\n  @HttpCode(HttpStatus.OK)\n  @RequirePermissions({ action: 'delete', subject: 'Case' })\n  delete(@Param('id') id: string, @CurrentUser() user: AuthUser, @Req() req: ScopedRequest) {\n    return this.conclusionsService.delete(id, user.id, { ipAddress: req.ip, userAgent: req.headers['user-agent'] }, req.dataScope);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\conclusions\\conclusions.module.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\conclusions\\conclusions.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-2026