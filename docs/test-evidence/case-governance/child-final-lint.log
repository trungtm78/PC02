rue,` with `⏎······receivedDate:·true,⏎·····`","line":2830,"column":25,"nodeType":null,"messageId":"replace","endLine":2830,"endColumn":45,"fix":{"range":[100445,100465],"text":"\n      receivedDate: true,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·where:·scopedWhere(exactSignals),·select,·take:·200,·orderBy:·{·updatedAt:·'desc'·}` with `⏎············where:·scopedWhere(exactSignals),⏎············select,⏎············take:·200,⏎············orderBy:·{·updatedAt:·'desc'·},⏎·········`","line":2834,"column":42,"nodeType":null,"messageId":"replace","endLine":2834,"endColumn":126,"fix":{"range":[100641,100725],"text":"\n            where: scopedWhere(exactSignals),\n            select,\n            take: 200,\n            orderBy: { updatedAt: 'desc' },\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·where:·scopedWhere(nameSignal),·select,·take:·50,·orderBy:·{·updatedAt:·'desc'·}` with `⏎············where:·scopedWhere(nameSignal),⏎············select,⏎············take:·50,⏎············orderBy:·{·updatedAt:·'desc'·},⏎·········`","line":2837,"column":42,"nodeType":null,"messageId":"replace","endLine":2837,"endColumn":123,"fix":{"range":[100825,100906],"text":"\n            where: scopedWhere(nameSignal),\n            select,\n            take: 50,\n            orderBy: { updatedAt: 'desc' },\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `...new·Map([...exactRows,·...nameRows].map((row)·=>·[row.id,·row])).values()` with `⏎······...new·Map(⏎········[...exactRows,·...nameRows].map((row)·=>·[row.id,·row]),⏎······).values(),⏎····`","line":2840,"column":19,"nodeType":null,"messageId":"replace","endLine":2840,"endColumn":95,"fix":{"range":[100967,101043],"text":"\n      ...new Map(\n        [...exactRows, ...nameRows].map((row) => [row.id, row]),\n      ).values(),\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":2841,"column":16,"nodeType":null,"messageId