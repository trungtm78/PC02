.id,\n      { ipAddress: req.ip, userAgent: req.headers['user-agent'] },\n      req.dataScope,\n    );\n  }\n\n  @Delete(':id')\n  @HttpCode(HttpStatus.OK)\n  @RequirePermissions({ action: 'delete', subject: 'Case' })\n  delete(@Param('id') id: string, @CurrentUser() user: AuthUser, @Req() req: ScopedRequest) {\n    return this.service.delete(id, user.id, { ipAddress: req.ip, userAgent: req.headers['user-agent'] }, req.dataScope);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\investigation-supplements\\investigation-supplements.module.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\investigation-supplements\\investigation-supplements.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\lawyers\\bulk\\lawyers.bulk.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\PC02\\pc02-case-management\\.worktrees\\case-governance-20261006\\backend\\src\\lawyers\\lawyers.controller.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `id,·dto,·user.id,` with `⏎······id,⏎······dto,⏎······user.id,⏎·····`","line":77,"column":39,"nodeType":null,"messageId":"replace","endLine":77,"endColumn":56,"fix":{"range":[2317,2334],"text":"\n      id,\n      dto,\n      user.id,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":78,"column":1,"nodeType":null,"messageId":"insert","endLine":