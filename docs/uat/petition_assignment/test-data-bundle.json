      "role": "OFFICER",
      "permissions": ["petition:read", "petition:edit"],
      "team": "team-A",
      "isLeader": false
    },
    "officer2": {
      "email": "officer2@pc02.local",
      "password_env": "TEST_OFFICER2_PASSWORD",
      "role": "OFFICER",
      "permissions": ["petition:read", "petition:edit"],
      "team": "team-A",
      "isLeader": false
    },
    "approver1": {
