    },
    "no_token": {
      "description": "Không có JWT token — dùng để test 401",
      "token": null
    },
    "expired_token": {
      "description": "JWT đã hết hạn",
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0IiwiaWF0IjoxNjAwMDAwMDAwLCJleHAiOjE2MDAwMDAwMDF9.EXPIRED",
      "note": "Hard-coded expired JWT cho test 401 expired"
    },
    "wrong_secret_token": {
      "description": "JWT được ký bằng secret sai",
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0IiwiaWF0IjoxNzE3MDAwMDAwLCJleHAiOjk5OTk5OTk5OTl9.WRONG_SECRET",
      "note": "Test 401 invalid signature"
