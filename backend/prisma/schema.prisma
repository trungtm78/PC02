  id          String    @id @default(cuid())
  // Địa chỉ cũ (trước 01/07/2025 — có cấp quận/huyện)
  oldWard     String // VD: "phường 14", "xã Long Bình" (lowercase)
  oldDistrict String // VD: "quận phú nhuận", "huyện nhà bè" (lowercase)
  // Địa chỉ mới (sau cải cách 2025 — chỉ còn phường/xã + tỉnh/TP)
  newWard     String // VD: "phường phú nhuận" (lowercase)
  province    String // Province code: "HCM", "HN", v.v.
  note        String? // Ghi chú nguồn (VD: "NQ 1279/NQ-UBTVQH15")
  isActive    Boolean   @default(true)
  needsReview Boolean   @default(false) // Đánh dấu cần review sau crawl
  // Provenance & ambiguity tracking (added v0.13.10.0)
  source      String    @default("manual") // 'api-v2' | 'manual' | 'official-decree'
  seededAt    DateTime? // when the row was last touched by bulkSeedFromApi
  candidates  Json? // when needsReview, all candidate new wards from API
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([oldWard, oldDistrict, province])
  @@index([province, oldDistrict])
  @@index([needsReview])
  @@map("address_mappings")
}

// Tracks bulk-seed jobs run by admin against provinces.open-api.vn.
// Status flow: queued → running → completed | failed | cancelled
model AddressSeedJob {
  id          String    @id @default(cuid())
  province    String // 'HCM' | 'HN' | ...
  status      String // 'queued' | 'running' | 'completed' | 'failed' | 'cancelled'
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  totalWards  Int       @default(0)
  mappedCount Int       @default(0)
  errorCount  Int       @default(0)
  needsReview Int       @default(0)
  cancelToken String? // Set to 'requested' to signal worker to abort
  errorLog    String? // JSON array of {wardCode, error}
  triggeredBy String // userId

  @@index([province, status])
  @@map("address_seed_jobs")
}

// Holiday model + HolidayCategory enum REMOVED in PR 3 (v0.20.0.0).
// All 25 holiday rows migrated to CalendarEvent with scope=SYSTEM via migration
// `20260513140000_calendar_events_v2_phase3_drop_holiday`.
// See CalendarEvent + EventCategory models below for the unified schema.

// ─────────────────────────────────────────────────────────────────────────────
// Calendar Events v2 (PR 1 — schema only, gated by feature flag `calendar_events_v2`)
//
// Schema mới song song với Holiday. Holiday giữ nguyên trong PR 1.
// PR 2 implement full service/controller. PR 3 migrate data + drop Holiday.
// ─────────────────────────────────────────────────────────────────────────────

enum EventScope {
  SYSTEM // Sự kiện toàn ngành — admin tạo, mọi user thấy
  TEAM // Sự kiện cấp tổ — tổ trưởng/admin tạo, chỉ thành viên tổ thấy
  PERSONAL // Sự kiện cá nhân — user tự tạo, chỉ mình thấy
}

enum ReminderChannel {
  FCM
  EMAIL
}

model EventCategory {
  id        String   @id @default(cuid())
  slug      String   @unique // "national", "police", "military", "international", "other", ...
  name      String // "Quốc gia", "Ngành Công an", "Quân đội", ...
  color     String // hex "#DC2626"
  icon      String? // lucide icon name, optional
  isSystem  Boolean  @default(false) // true → không cho xóa (5 default categories)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@index([sortOrder])
  @@map("event_categories")
}

model CalendarEvent {
  id               String    @id @default(cuid())
  title            String
  shortTitle       String?
  description      String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date // multi-day events
  startTime        String? // "HH:MM" — null khi allDay
  endTime          String?
  allDay           Boolean   @default(true)
  isOfficialDayOff Boolean   @default(false)
  lunarDate        String?

  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  scope  EventScope
  teamId String? // required khi scope=TEAM
  team   Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String? // required khi scope=PERSONAL
  user   User?      @relation("PersonalEvents", fields: [userId], references: [id], onDelete: SetNull)

  recurrenceRule    String? // RRULE string RFC 5545, e.g. "FREQ=YEARLY"
  recurrenceEndDate DateTime? @db.Date // when to stop recurring (null = forever)

  createdById String
  createdBy   User      @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  reminders EventReminder[]
  overrides CalendarEventOccurrenceOverride[]

  @@index([startDate])
  @@index([categoryId])
  @@index([deletedAt])
  // Partial indexes added in migration SQL (Prisma doesn't support partial indexes natively)
  @@map("calendar_events")
}

// Thin override table for RFC 5545 RECURRENCE-ID + EXDATE pattern.
// Replaces self-FK `recurrenceParentId` approach (Eng review #3) — 50 bytes vs 500 per override.
model CalendarEventOccurrenceOverride {
  id             String        @id @default(cuid())
  eventId        String
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime      @db.Date // The original recurrence date being overridden
  excluded       Boolean       @default(false) // EXDATE: skip this occurrence
  overrideFields Json? // { title?, description?, startTime?, endTime?, ... }
  createdAt      DateTime      @default(now())

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
  @@map("calendar_event_occurrence_overrides")
}

model EventReminder {
  id            String            @id @default(cuid())
  eventId       String
  event         CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String // user nhận reminder
  user          User              @relation("EventReminders", fields: [userId], references: [id], onDelete: Cascade)
  minutesBefore Int // 30 = 30 phút trước, 1440 = 1 ngày, 10080 = 1 tuần
  channels      ReminderChannel[] // [FCM] | [EMAIL] | [FCM, EMAIL]
  createdAt     DateTime          @default(now())

  dispatches EventReminderDispatch[]

  @@index([eventId])
  @@index([userId])
  @@map("event_reminders")
}

model EventReminderDispatch {
  id             String            @id @default(cuid())
  reminderId     String
  reminder       EventReminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime          @db.Date // occurrence cụ thể của recurring event
  sentAt         DateTime          @default(now())
  channels       ReminderChannel[]

  @@unique([reminderId, occurrenceDate])
  @@index([reminderId])
  @@index([sentAt]) // cho prune cron daily 02:00 (Eng audit #10)
  @@map("event_reminder_dispatches")
}

// ─────────────────────────────────────────────
// Document Number Engine (v0.42)
// Odoo-style configurable document number sequences with row-level lock safety.
// ─────────────────────────────────────────────

model DocumentNumberTemplate {
  id            String   @id @default(uuid())
  name          String // "Mã vụ việc", "Số tiếp nhận đơn thư", ...
  documentType  String // "INCIDENT" | "PETITION" | "CASE" | "PROPOSAL" | "DELEGATION" | "EVIDENCE"
  isActive      Boolean  @default(true)
  separator     String   @default("-") // "" = không phân cách
  inputMode     String   @default("AUTO") // "AUTO" | "MANUAL" | "AUTO_WITH_OVERRIDE"
  segments      Json // Segment[] — ordered array of LITERAL | FORMULA | COUNTER
  counterConfig Json // { resetPeriod, minValue, maxValue, padding }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  counters DocumentNumberCounter[]
  logs     DocumentNumberLog[]

  @@index([documentType])
  @@index([isActive])
  @@map("document_number_templates")
}

model DocumentNumberCounter {
  id           String                 @id @default(uuid())
  templateId   String
  template     DocumentNumberTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  periodKey    String // "2026" | "2026-05" | "2026-W21" | "global"
  currentValue Int                    @default(0)
  resetAt      DateTime?
  updatedAt    DateTime               @updatedAt

  @@unique([templateId, periodKey])
  @@index([templateId])
  @@map("document_number_counters")
}

model DocumentNumberLog {
  id              String                 @id @default(uuid())
  templateId      String
  template        DocumentNumberTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  generatedNumber String
  documentType    String
  documentId      String? // loose FK — updated after parent document saved
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  isDraft         Boolean                @default(false)
  createdAt       DateTime               @default(now())

  @@index([templateId, createdAt])
  @@index([userId])
  @@index([documentId])
  @@map("document_number_logs")
}

// ─────────────────────────────────────────────
// v0.47 — Document + Report Template Engine v1.0
// PR1 foundation: render audit + statistical reports + xlsx import staging.
// Reuses v0.42 DocumentNumberTemplate + commitWithTx for series/numbering
// (no parallel DocumentTemplateRegistry — superseded F3).
// ─────────────────────────────────────────────

// One row per docx/xlsx render. Single source of truth for "has petition X
// been issued PHIEU_DE_XUAT yet?" — replaces 4 cache columns per docType on
// Petition (superseded CQ2/CQ3).
model DocumentRenderLog {
  id              String    @id @default(cuid())
  petitionId      String?
  petition        Petition? @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  caseId          String?
  case            Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  incidentId      String?
  incident        Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  documentType    String // 'PHIEU_DE_XUAT' | 'PHIEU_CHUYEN_NGUON_TIN' | 'PHIEU_CHUYEN_DON' | 'THONG_BAO_CHUYEN' | 'THONG_BAO_HUONG_DAN' | 'THONG_BAO_TRA_LAI' | 'PHU_LUC_01..06'
  templateSha     String // SHA256 of binary template at render time (audit pháp lý)
  renderedAt      DateTime  @default(now())
  renderedById    String
  renderedBy      User      @relation("RenderedBy", fields: [renderedById], references: [id])
  generatedNumber String? // số văn bản (FK soft → DocumentNumberLog)
  fileSha         String? // SHA256 of output file (audit trail)

  @@index([petitionId, documentType, renderedAt(sort: Desc)])
  @@index([caseId, documentType])
  @@index([incidentId, documentType])
  @@index([renderedById])
  @@map("document_render_logs")
}

// Statistical xlsx report generation log (Phụ lục 01-06).
// One row per Phụ lục file generated for an đơn vị + period.
model PhuLucReportLog {
  id            String   @id @default(cuid())
  reportType    String // 'PHU_LUC_01' .. 'PHU_LUC_06'
  periodStart   DateTime
  periodEnd     DateTime
  unitCode      String? // NULL = aggregate Phòng-level cho PC02
  generatedById String
  generatedBy   User     @relation("PhuLucGeneratedBy", fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())
  rowCount      Int
  fileSize      Int // bytes
  fileSha       String // SHA256 of output xlsx

  @@index([reportType, periodStart])
  @@index([unitCode])
  @@index([generatedById])
  @@map("phu_luc_report_logs")
}

// Xlsx upload + import lifecycle (Track B import).
// SHA dedupe, dual-confirm, rollback per Codex SPLIT verdict requirements.
model XlsxImportLog {
  id               String   @id @default(cuid())
  sourceFile       String // original filename
  fileSize         Int
  fileSha          String   @unique // dedupe — same content → reuse existing log
  uploadedById     String
  uploadedBy       User     @relation("XlsxImportUploader", fields: [uploadedById], references: [id])
  uploadedAt       DateTime @default(now())
  unitCodeDetected String? // extracted from filename
  succeededRows    Int      @default(0)
  skippedRows      Int      @default(0)
  conflictedRows   Int      @default(0)
  errorRows        Int      @default(0)
  status           String   @default("PARSED") // PARSED | PENDING_SECOND_CONFIRM | COMMITTED | FAILED | ROLLED_BACK
  errorDetail      Json?

  // Dual-confirm tracking (Codex CRITICAL #7) — 24h window enforced at app layer
  firstConfirmById  String?
  firstConfirmBy    User?     @relation("XlsxFirstConfirm", fields: [firstConfirmById], references: [id], onDelete: SetNull)
  firstConfirmAt    DateTime?
  secondConfirmById String?
  secondConfirmBy   User?     @relation("XlsxSecondConfirm", fields: [secondConfirmById], references: [id], onDelete: SetNull)
  secondConfirmAt   DateTime?

  // Rollback audit
  rolledBackById String?
  rolledBackBy   User?     @relation("XlsxRolledBack", fields: [rolledBackById], references: [id], onDelete: SetNull)
  rolledBackAt   DateTime?

  staging           XlsxImportStaging[]
  importedCases     Case[]              @relation("XlsxImportLogCases")
  importedIncidents Incident[]          @relation("XlsxImportLogIncidents")

  @@index([status])
  @@index([uploadedById])
  @@index([uploadedAt])
  @@map("xlsx_import_logs")
}

// Parser writes here ONLY (never direct upsert into Case/Incident) per Codex #3.
// Commit endpoint reads staging → creates real Case/Incident rows.
model XlsxImportStaging {
  id             String        @id @default(cuid())
  importLogId    String
  importLog      XlsxImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  sheetName      String // 'Phụ lục 01' | 'Phụ lục 02' | ...
  rowIndex       Int // 1-based row in source xlsx (for error messages)
  payload        Json // raw cell values after formula stripping
  detectedType   String? // 'Case' | 'Incident' | null (unmappable)
  conflictReason String? // 'unit_mismatch' | 'duplicate_id' | null

  @@index([importLogId, sheetName])
  @@index([conflictReason])
  @@map("xlsx_import_staging")
}

/// Mẫu chứng từ động (.docx) cho vụ việc/vụ án/đơn thư — admin upload, không cần deploy.
/// File lưu DB (Bytes) tránh footgun bundling asset lúc deploy. Biến auto-detect khi upload.
model DocumentTemplate {
  id             String    @id @default(cuid())
  code           String // unique theo (entityType, code) — xem @@unique
  name           String
  entityType     String // VU_VIEC | VU_AN | DON_THU
  category       String // Quyết định | Biên bản | Lệnh | Thông báo | Giấy chứng nhận | Khác
  fileBytes      Bytes
  fileSha        String
  fileName       String
  variables      Json      @default("[]") // [{name, label, source:'auto'|'manual', field?, required?}]
  format         String    @default("DOCX") // DOCX nay; mở XLSX/PDF sau (multi-format)
  delimStart     String    @default("{") // ký tự mở placeholder (admin chọn lúc upload)
  delimEnd       String    @default("}") // ký tự đóng placeholder
  needsNumber    Boolean   @default(false)
  numberSeriesId String? // FK lỏng tới DocumentNumberTemplate (cấp số khi needsNumber)
  status         String    @default("active")
  sortOrder      Int       @default(0)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // [codex P2] unique (entityType,code) là PARTIAL index WHERE deletedAt IS NULL (xem migration) —
  // cho phép tái tạo mã sau khi soft-delete. Prisma không express partial unique nên để raw trong migration.
  @@index([entityType, status])
  @@index([category])
  @@map("document_templates")
}

// ═════════════════════════════════════════════════════════════════
// Di trú dữ liệu hệ thống cũ (MongoDB dump pc02hcm.com → PostgreSQL)
//
//  105 .bson ─► stage ─► LegacyStaging ─┐
//                                       ▼
//   LegacyUnitAlias (có kiểm duyệt) ─► preflight ─► CHẶN nếu có lỗi
//                                       ▼
//                        legacy-mapper ─► import ─► bảng vận hành
//                                       ▼           └► LegacyImportError
//                                  reconcile ─► báo cáo trước/sau
//
// Bản thô là NGUỒN CHÂN LÝ: mọi biến đổi diễn ra SAU khi đã nạp vào LegacyStaging,
// nên lỗi ánh xạ luôn chạy lại được mà không phải đọc lại 411MB BSON.
// ═════════════════════════════════════════════════════════════════

/// Một dòng = một document BSON NGUYÊN VĂN. Không cắt cột `_search`, không bỏ cột rỗng.
model LegacyStaging {
  id         String   @id @default(cuid())
  runId      String
  sourceFile String // "ho_so_doi_1.bson"
  sourceId   String // rec.id ép về chuỗi
  rowHash    String // sha256 của document — chống nạp trùng trong cùng lần chạy
  raw        Json
  createdAt  DateTime @default(now())

  // Khoá tự nhiên: cùng id ở hai collection khác nhau là HAI bản ghi khác nhau
  // (`ho_so.id` [1,2,3,4] trùng 100% với `ho_so_doi_1` — đo trên dump thật).
  @@unique([sourceFile, sourceId])
  @@index([runId])
  @@map("legacy_staging")
}

/// Sổ theo dõi từng lần chạy: cho phép chạy tiếp sau khi tiến trình chết giữa chừng.
model LegacyImportRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("RUNNING") // RUNNING | DONE | FAILED | ABORTED
  sourceChecksums  Json      @default("{}") // {file: sha256} — chốt nguồn chân lý
  // Phiên bản quy tắc sinh legacySourceId. Lệch phiên bản ⇒ TỪ CHỐI chạy tiếp,
  // vì đổi quy tắc khoá giữa chừng sẽ nhân đôi toàn bộ 53.820 hồ sơ.
  legacyKeyVersion String    @default("v2-collection-prefixed")
  lastBatchNo      Int       @default(0)
  counts           Json      @default("{}")
  note             String?

  @@index([status])
  @@map("legacy_import_runs")
}

/// Bảng alias đơn vị — CÓ KIỂM DUYỆT.
/// Đo trên 100% dữ liệu: `don_vi_giai_quyet` chỉ khớp tên đơn vị 28,82% (15.509/53.820).
/// Trường này lẫn ba thứ khác nhau nên phải phân loại rõ trước khi ghi:
///   TEAM          → tổ nội bộ, gán assignedTeamId
///   EXTERNAL_ORG  → cơ quan ngoài (Công an quận X, PC01…), giữ ở cột text
///   RESULT        → thực ra là KẾT QUẢ xử lý ("Trả đơn, hướng dẫn khởi kiện tại TAND")
///   UNKNOWN       → chưa phân loại; preflight CHẶN nếu còn giá trị ≥100 hồ sơ ở nhóm này
model LegacyUnitAlias {
  id          String    @id @default(cuid())
  rawValue    String    @unique // chuỗi gốc đã chuẩn hoá (bỏ dấu, gộp khoảng trắng, lowercase)
  sampleRaw   String? // một bản gốc chưa chuẩn hoá để người duyệt dễ nhận ra
  kind        String    @default("UNKNOWN")
  teamId      String? // chỉ dùng khi kind = TEAM
  recordCount Int       @default(0) // số hồ sơ mang giá trị này — để duyệt theo mức ảnh hưởng
  note        String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind])
  @@map("legacy_unit_aliases")
}

/// Bản ghi bị CHẶN — thà đếm được còn hơn bịa dữ liệu.
/// Trước đây `receivedDate ?? new Date()` gán ngày hôm nay cho hồ sơ 2017 (~4.400 bản ghi).
model LegacyImportError {
  id         String   @id @default(cuid())
  runId      String
  sourceFile String
  sourceId   String
  reason     String // MISSING_REQUIRED_DATE | UNKNOWN_UNIT | UNKNOWN_CLASS | CRIME_AMBIGUOUS | ...
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([runId, reason])
  @@map("legacy_import_errors")
}

/// Chẩn đoán phân tích trường — thay cho việc nhân đôi 275 cột thành `<cột>_raw`.
/// Cho biết ngày "…/…/2020" là mất trắng hay còn giữ được độ chính xác tới NĂM.
model LegacyFieldDiagnostic {
  id        String   @id @default(cuid())
  runId     String
  field     String
  raw       String
  parsed    String?
  precision String? // day | month | year | none
  reason    String?
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([runId, field])
  @@map("legacy_field_diagnostics")
}
