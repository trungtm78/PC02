// ─────────────────────────────────────────────
// Bulk Operations (v0.48 PR1)
// 1 header row per bulk action (export/assign/transfer/status/extend). Items
// reference via AuditLog.bulkOperationId. Status STARTED→COMPLETED|FAILED,
// counts populated post-loop (plan eng E-H3).
// idempotencyKey + actorId unique → retry-safe (plan eng E-H10).
// ─────────────────────────────────────────────
enum BulkOperationStatus {
  STARTED
  COMPLETED
  FAILED
}

model BulkOperation {
  id             String              @id @default(cuid())
  // actorId nullable + onDelete SetNull để giữ audit trail (match AuditLog.userId pattern).
  // Investigation system: "ai làm gì lúc nào" phải retained forever, kể cả user bị xóa.
  actorId        String?
  resource       String // e.g. "Case", "Incident", "Petition"
  action         String // e.g. "BULK_EXPORT", "BULK_ASSIGN", "BULK_TRANSFER"
  status         BulkOperationStatus @default(STARTED)
  idempotencyKey String?
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  succeededCount Int                 @default(0)
  skippedCount   Int                 @default(0)
  failedCount    Int                 @default(0)

  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  auditItems AuditLog[]

  @@unique([actorId, idempotencyKey])
  @@index([actorId, startedAt(sort: Desc)])
  @@index([resource, action])
  @@map("bulk_operations")
}

