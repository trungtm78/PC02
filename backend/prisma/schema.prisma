// PC02 Case Management System - Prisma Schema
// TASK-2026-0225-001-STEP1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// RBAC: Role & Permission
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String // e.g. "read", "write", "delete"
  subject     String // e.g. "Case", "User", "AuditLog"
  conditions  Json? // ABAC conditions (optional JSON)
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // Magic link enrollment (post-/autoplan): email nullable cho user không có email.
  // Login lookup multi-field qua regex disambiguator (auth.service.ts) — workId/phone/email/username.
  email              String?   @unique
  username           String    @unique
  passwordHash       String
  firstName          String?
  lastName           String?
  workId             String?   @unique // Mã cán bộ (XXX-XXX) — partial unique cho non-null
  phone              String? // KHÔNG @unique (vợ chồng share — CEO finding #10)
  // Magic link enrollment fields. Token bcrypt-hash + TTL 72h. NULL sau khi user consume.
  enrollmentTokenHash String?
  enrollmentExpiresAt DateTime?
  departmentId       String? // ID đơn vị từ danh mục
  isActive           Boolean   @default(true)
  roleId             String
  refreshTokenHash   String? // hashed refresh token for rotation
  tokenVersion       Int       @default(0) // incremented on password change to invalidate existing JWTs
  // Sprint 1 / S1.2 — account lockout: counter tăng theo mỗi lần fail password,
  // reset về 0 khi login success. Khi đạt MAX_FAILED_LOGIN_ATTEMPTS thì set
  // lockedUntil = now + LOCKOUT_DURATION_MS. Locked user bị reject ở login
  // gate trước khi bcrypt.compare chạy.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  canDispatch        Boolean   @default(false) // supplementary permission: read all + assign/reassign any record
  lastLoginAt        DateTime?
  // 2FA fields
  totpSecret         String? // AES-256-GCM encrypted base32 secret
  totpEnabled        Boolean   @default(false)
  // Sprint 2 / S2.4 — buộc user setup 2FA trước khi dùng app.
  // Default true cho user MỚI (login đầu tiên redirect setup). Existing users
  // được seed false để không break flow hiện tại; admin có thể bật cho ai cần.
  twoFaSetupRequired Boolean   @default(true)
  totpSetupPending   Boolean   @default(false)
  totpSetupPendingAt DateTime?
  backupCodes        String[]
  backupCodeSalts    String[]
  lastTotpCode       String? // replay protection — last used TOTP code in current window
  twoFaSetupAt       DateTime?
  twoFaUsedAt        DateTime? // OV-002: marks twoFaToken as consumed, survives restart
  // Force first-login password change (D1+F1): set true when admin creates user OR resets password.
  // Cleared when user completes /auth/first-login-change-password.
  // Used as state-derived single-use marker for the change_password_pending token (per H1 review).
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime? // last successful password change (admin reset or user-initiated)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role                            Role                      @relation(fields: [roleId], references: [id])
  auditLogs                       AuditLog[]
  cases                           Case[]
  petitionsEntered                Petition[]                @relation("PetitionEnteredBy")
  petitionsAssigned               Petition[]                @relation("PetitionAssignedTo")
  incidentsAssigned               Incident[]                @relation("IncidentInvestigator")
  incidentsCanBoNhap              Incident[]                @relation("IncidentCanBoNhap")
  incidentsCreated                Incident[]                @relation("IncidentCreatedBy")
  incidentStatusChanges           IncidentStatusHistory[]   @relation("IncidentStatusChangedBy")
  documents                       Document[] // Tài liệu đã upload
  proposalsCreated                Proposal[]                @relation("ProposalCreatedBy")
  guidanceRecords                 GuidanceRecord[]          @relation("GuidanceCreatedBy")
  exchangesCreated                Exchange[]                @relation("ExchangeCreatedBy")
  exchangeMessages                ExchangeMessage[]         @relation("ExchangeMessageSender")
  delegationsCreated              Delegation[]              @relation("DelegationCreatedBy")
  conclusionsAuthored             Conclusion[]              @relation("ConclusionAuthor")
  conclusionsApproved             Conclusion[]              @relation("ConclusionApprover")
  statusChanges                   CaseStatusHistory[]       @relation("StatusChangedBy")
  investigationSupplementsCreated InvestigationSupplement[] @relation("SupplementCreatedBy")
  notifications                   Notification[]
  userTeams                       UserTeam[]
  grantsReceived                  DataAccessGrant[]         @relation("GrantReceived")
  grantsGiven                     DataAccessGrant[]         @relation("GrantGiven")
  abbreviations                   UserAbbreviation[]
  shortcuts                       UserShortcut[]
  devices                         UserDevice[]
  overdueNotifications            OverdueNotification[]
  vksMeetingsCreated              VksMeetingRecord[]        @relation("VksMeetingCreatedBy")
  actionPlansCreated              SuspensionActionPlan[]    @relation("ActionPlanCreatedBy")
  reportTdcCreated                ReportTdcDraft[]          @relation("ReportCreatedBy")
  reportTdcReviewed               ReportTdcDraft[]          @relation("ReportReviewedBy")
  reportTdcApproved               ReportTdcDraft[]          @relation("ReportApprovedBy")
  reportTdcRejected               ReportTdcDraft[]          @relation("ReportRejectedBy")
  // Deadline rule versioning
  deadlineRulesProposed           DeadlineRuleVersion[]     @relation("DeadlineRuleProposer")
  deadlineRulesReviewed           DeadlineRuleVersion[]     @relation("DeadlineRuleReviewer")
  // Calendar Events v2 (PR 1 schema only)
  personalCalendarEvents          CalendarEvent[]           @relation("PersonalEvents")
  calendarEventsCreated           CalendarEvent[]           @relation("CalendarEventCreatedBy")
  calendarEventsUpdated           CalendarEvent[]           @relation("CalendarEventUpdatedBy")
  eventReminders                  EventReminder[]           @relation("EventReminders")
  // Magic link enrollment audit (post-/autoplan)
  enrollmentTokensReceived        EnrollmentTokenAudit[]    @relation("EnrollmentTokenSubject")
  enrollmentTokensGenerated       EnrollmentTokenAudit[]    @relation("EnrollmentTokenGenerator")
  // Bulk import jobs (v0.25.0.0) — admin upload xlsx/csv → batch create users.
  // Durable audit trail thay BullMQ Redis-only (Eng review E1).
  bulkImportJobs                  BulkImportJob[]           @relation("BulkImportJobGenerator")
  // v0.31.0.2: track Case creator để áp quyền xóa (creator-or-admin)
  casesCreated                    Case[]                    @relation("CaseCreator")
  // v0.33.0.0 Phase 5b: edit window reset requests
  resetRequestsRequested          EditWindowResetRequest[]  @relation("ResetRequestRequester")
  resetRequestsReviewed           EditWindowResetRequest[]  @relation("ResetRequestReviewer")
  // Document Number Engine (v0.42)
  documentNumberTemplatesCreated  DocumentNumberTemplate[]
  documentNumberLogs              DocumentNumberLog[]

  @@map("users")
}

// Magic link enrollment audit (post-/autoplan).
// Track admin gen + user click — không lưu plaintext token.
model EnrollmentTokenAudit {
  id          String    @id @default(cuid())
  userId      String
  generatedBy String
  generatedAt DateTime  @default(now())
  consumedAt  DateTime?
  consumedIp  String?
  consumedUa  String?
  expiresAt   DateTime
  channelHint String?
  user        User      @relation("EnrollmentTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  generator   User      @relation("EnrollmentTokenGenerator", fields: [generatedBy], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("enrollment_token_audits")
}

// Bulk import jobs (v0.25.0.0).
// Replace BullMQ-only state với durable Postgres audit trail (Eng review E1):
// who imported, source file SHA, row outcomes JSON, enriched file path, expiry.
// BullMQ chỉ dùng queue + progress signaling; source of truth = Postgres.
model BulkImportJob {
  id               String    @id @default(cuid())
  generatedBy      String
  sourceFilename   String
  sourceSha256     String
  totalRows        Int
  successRows      Int       @default(0)
  errorRows        Int       @default(0)
  status           String // queued | processing | done | failed | cancelled
  progress         Int       @default(0)
  rowOutcomes      Json? // [{rowIndex, userId?, error?}]
  originalFilePath String? // /tmp/pc02-bulk/{id}.xlsx
  enrichedFilePath String? // /tmp/pc02-bulk/{id}-enriched.xlsx
  downloadCount    Int       @default(0)
  errorMessage     String?
  startedAt        DateTime?
  finishedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  generator        User      @relation("BulkImportJobGenerator", fields: [generatedBy], references: [id])

  @@index([generatedBy, createdAt])
  @@index([expiresAt])
  @@map("bulk_import_jobs")
}

// ─────────────────────────────────────────────
// System Directories
// ─────────────────────────────────────────────

model Directory {
  id             String    @id @default(cuid())
  type           String // e.g. "CRIME", "ORG", "LOCATION", "STATUS"
  code           String // e.g. "VA", "T01"
  name           String
  description    String?
  parentId       String?
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  abolishedAt    DateTime? // null = active; set = abolished from this date (cải cách hành chính)
  replacedByCode String? // code of successor unit after abolition
  metadata       Json? // Specific data for each type
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // v0.33.0.0: inverse — Teams gắn ward (geographic teams)
  teams          Team[]    @relation("TeamWard")

  // v0.34.0.0: snapshot pattern metadata (WARD/PROVINCE only — NULL cho type khác)
  officialCode   String? // mã chính danh Bộ Nội vụ (vd "26506" cho Phường 1 TPHCM)
  sourceVersion  String? // vd "v2024-1279" — version dataset đã import row này
  legalBasis    String? // vd "Nghị quyết 1279/QH15 ngày 12/06/2024"
  importedAt     DateTime? // thời điểm import từ dataset

  @@unique([type, code])
  // v0.34.0.0: partial index on (type, officialCode) created via separate CONCURRENTLY
  // migration (20260522092131_directories_official_code_index_concurrent). NOT modeled
  // as @@index here — Prisma would generate a duplicate non-partial index on drift check.
  @@map("directories")
}

// v0.34.0.0: Dataset import ledger (state machine cho snapshot import)
// Mỗi version chỉ có 1 ACTIVE row tại 1 thời điểm (partial unique index)
model AdminUnitDatasetImport {
  version          String    @id // vd "v2024-1279"
  status           String // IMPORTING | ACTIVE | SUPERSEDED | FAILED
  checksum         String // SHA256 hex
  addedProvinces   Int       @default(0)
  addedWards       Int       @default(0)
  updatedWards     Int       @default(0)
  abolishedWards   Int       @default(0)
  importedAt       DateTime  @default(now())
  completedAt      DateTime?
  errorMessage     String?

  @@map("admin_unit_dataset_imports")
}

