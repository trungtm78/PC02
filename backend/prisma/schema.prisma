// ─────────────────────────────────────────────
// Audit Log
// ─────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String // e.g. "USER_LOGIN", "USER_LOGOUT", "CASE_CREATED"
  subject         String? // entity type affected
  subjectId       String? // entity id affected
  metadata        Json? // additional context (IP, user-agent, etc.)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  // v0.48 PR1 B2: link N item rows to 1 BulkOperation header (audit-inside-tx pattern).
  bulkOperationId String?

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  bulkOperation BulkOperation? @relation(fields: [bulkOperationId], references: [id], onDelete: SetNull)

