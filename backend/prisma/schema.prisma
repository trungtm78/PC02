  CHUA_CO_KET_QUA_TUONG_TRO // 3 Chưa có kết quả yêu cầu nước ngoài tương trợ TP
  YEU_CAU_TAI_LIEU_CHUA_CO // 4 Đã yêu cầu cung cấp tài liệu nhưng chưa có kết quả
  BAT_KHA_KHANG // 5 Bất khả kháng: thiên tai, dịch bệnh
  CAN_CU_KHAC // 6 Căn cứ tạm đình chỉ khác

  @@map("ly_do_tam_dinh_chi_vu_viec")
}

enum KetQuaPhucHoiVuViec {
  QUYET_DINH_KHOI_TO // 3.3.1 Quyết định khởi tố VAHS
  QUYET_DINH_KHONG_KHOI_TO // 3.3.2 Quyết định không khởi tố VAHS
  TAM_DINH_CHI_LAI // 3.3.3 Tạm đình chỉ lại
  DANG_XAC_MINH // 3.3.4 Đang xác minh
  CHUYEN_CO_QUAN_KHAC // 3.3.5 Chuyển cơ quan khác

  @@map("ket_qua_phuc_hoi_vu_viec")
}

enum TienDoKhacPhuc {
  DANG_THUC_HIEN // Đang thực hiện
  DAM_BAO // Đảm bảo (tính vào row 5.5)
  CHAM_TRE // Chậm trễ
  KHONG_DAT // Không đạt

  @@map("tien_do_khac_phuc")
}

enum ReportTdcType {
  VU_AN // Vụ án tạm đình chỉ điều tra
  VU_VIEC // Vụ việc tạm đình chỉ giải quyết

  @@map("report_tdc_type")
}

enum ReportTdcStatus {
  DRAFT // Bản nháp
  REVIEWING // Đang xét duyệt
  REJECTED // Bị từ chối
  APPROVED // Đã phê duyệt
  FINALIZED // Đã khóa, immutable

  @@map("report_tdc_status")
}

// ─────────────────────────────────────────────
// Case Management
// ─────────────────────────────────────────────

enum CaseStatus {
  TIEP_NHAN // Tiếp nhận
  DANG_XAC_MINH // Đang xác minh
  DA_XAC_MINH // Đã xác minh
  DANG_DIEU_TRA // Đang điều tra
  TAM_DINH_CHI // Tạm đình chỉ
  DINH_CHI // Đình chỉ
  DA_KET_LUAN // Đã kết luận
  DANG_TRUY_TO // Đang truy tố
  DANG_XET_XU // Đang xét xử
  DA_LUU_TRU // Đã lưu trữ

  @@map("case_status")
}

model Case {
  id                  String        @id @default(cuid())
  name                String
  crime               String? // tội danh (text tự do — giữ tương thích cũ)
  crimeChinhId        String? // FK → crimes (master Tội danh BLHS 2015) — chuẩn như Petition
  status              CaseStatus    @default(TIEP_NHAN)
  investigatorId      String? // FK → users (nullable)
  deadline            DateTime?
  unit                String?
  subjectsCount       Int           @default(0)
  caseCode            String?       @unique // Mã hồ sơ (v0.42: promoted từ metadata, engine-generated)
  metadata            Json? // Lưu toàn bộ fields phụ của form (người báo tin, địa chỉ, v.v.)
  capDoToiPham        CapDoToiPham? // Mức độ tội phạm (BLHS 2015 Điều 9) — dùng cho KPI-4
  ngayKhoiTo          DateTime? // Ngày quyết định khởi tố vụ án
  // ── Field-parity hệ thống cũ — số QĐ các giai đoạn vụ án ──
  soQuyetDinhKhoiTo   String? // Số QĐ khởi tố vụ án
  soQDNhapVuAn        String? // Số QĐ nhập vụ án
  ngayNhapVuAn        DateTime?
  ghiChuNhapHoSo      String? // Ghi chú nhập vào hồ sơ nào
  soQDTachVuAn        String? // Số QĐ tách vụ án
  ngayTachVuAn        DateTime?
  soQDTachHanhVi      String? // Số QĐ tách hành vi
  ngayTachHanhVi      DateTime?
  soQDDinhChiVuAn     String? // Số QĐ đình chỉ vụ án
  ngayDinhChiVuAn     DateTime?
  chuyenVuAnChoCQK    String? // Chuyển vụ án cho CQĐT khác (số/ngày/đơn vị)
  soBanAnCoHieuLuc    String? // Số bản án có hiệu lực pháp luật
  ngayBanAnCoHieuLuc  DateTime?
  canCuTamDinhChiVuAn String? // Căn cứ (text) tạm đình chỉ vụ án
  canCuPhucHoiVuAn    String? // Căn cứ (text) phục hồi điều tra vụ án
  // Field-parity hệ thống cũ — KLĐT + QĐ điều tra lại
  soKLDT              String? // Số kết luận điều tra (old: ket_luan_dieu_tra_vu_an)
  ngayKLDT            DateTime? // Ngày kết luận điều tra (old: ngay_ket_luan_dieu_tra)
  soQDDieuTraLai      String? // Số QĐ điều tra lại (old: quyet_dinh_dieu_tra_lai)
  ngayQDDieuTraLai    DateTime? // Ngày QĐ điều tra lại (old: ngay_quyet_dinh_dieu_tra_lai)
  deletedAt           DateTime? // Soft delete
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // TĐC tracking fields (Phụ lục 08)
  laCongNgheCao         Boolean              @default(false)
  lyDoTamDinhChiText    String? // Backup của giá trị String cũ trước migration
  lyDoTamDinhChiVuAn    LyDoTamDinhChiVuAn[] // PR-8: MULTI — chọn nhiều lý do TĐC (Đ.229). Mảng rỗng = chưa chọn.
  soQuyetDinhTamDinhChi String?
  ngayTamDinhChi        DateTime?
  soLanTamDinhChi       Int                  @default(0)
  soLanGiaHan           Int                  @default(0)
  daRaSoat              Boolean              @default(false)
  ngayRaSoat            DateTime?
  soQuyetDinhPhucHoi    String?
  ngayPhucHoi           DateTime?
  ketQuaPhucHoiVuAn     KetQuaPhucHoiVuAn?
  ngayHetThoiHieu       DateTime? // Ngày hết thời hiệu truy cứu TNHS (dùng cho Phụ lục 5 vs 6)

  // v0.47 — TĐC khắc phục fields cho Phụ lục 05/06 (Vụ án TĐC)
  tdcKhacPhucLyDoBienPhap String? // Biện pháp khắc phục lý do TĐC
  tdcKhacPhucBienBan      String? // BB trao đổi VKS, KH khắc phục (số/ngày)

  // v0.47 — Import audit (Track B xlsx import) — per-row provenance per Codex #3
  importedFrom String? // "xlsx-phu-luc" | "manual" | "api"
  importedAt   DateTime?
  importedById String?
  importedBy   User?               @relation("CaseImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  sourceFile   String? // filename "DOI6 - ... xlsx"
  importLogId  String?
  importLog    XlsxImportLog?      @relation("XlsxImportLogCases", fields: [importLogId], references: [id], onDelete: SetNull)
  renderLogs   DocumentRenderLog[]

  // v0.31.0.2: creator track cho delete-with-reason (creator-or-admin check)
  // Legacy rows (pre-migration) = NULL → ADMIN-only delete (specific error message)
  createdById String?
  createdBy   User?   @relation("CaseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // v0.36.0.0 Phase 5-lite: warning flag — set true khi update sau Team.editWindowHours
  // (mặc định 168h theo BLTTHS Đ.147). Read-only audit, không enforce.
  editedAfterWindow Boolean @default(false)

  // v0.37.1 → v0.37.2 — Provenance model (Deploy-2 Contract: NOT NULL, no default)
  // BLTTHS Đ.143 source classification — required for every Case.
  // CHECK constraint enforces source-type↔FK consistency (see migration 20260523000000).
  caseProvenance     CaseProvenance
  linkedPetitionId   String?
  // PR 2 v0.38.1.0: @unique enforce 1 Incident ↔ 1 Case strict (eng-review D2)
  // Edge case "1 vụ việc tách 2 vụ án" → clone Incident với mã VV mới.
  linkedIncidentId   String?        @unique
  sourceDocumentNote String? // Ghi chú nguồn cho DIRECT_DISCOVERY / TRANSFERRED / OTHER_LEGAL_SOURCE

  // onDelete: Restrict — provenance không erase. App dùng soft delete.
  linkedPetition Petition? @relation("CaseSourcePetition", fields: [linkedPetitionId], references: [id], onDelete: Restrict)
  linkedIncident Incident? @relation("CaseSourceIncident", fields: [linkedIncidentId], references: [id], onDelete: Restrict)

  investigator    User?                     @relation(fields: [investigatorId], references: [id], onDelete: SetNull)
  crimeChinh      Crime?                    @relation("CaseCrimeChinh", fields: [crimeChinhId], references: [id], onDelete: SetNull)
  assignedTeamId  String?
  assignedTeam    Team?                     @relation("CaseTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  statusHistory   CaseStatusHistory[]
  subjects        Subject[]
  lawyers         Lawyer[] // TASK-2026-261225
  petitions       Petition[]                @relation("PetitionLinkedCase")
  documents       Document[] // TASK-2026-022601: Tài liệu liên quan
  evidences       Evidence[] // PR 1 v0.38.0.0: Vật chứng — atomic create với Case
  linkedIncidents Incident[]                @relation("IncidentLinkedCase")
  proposals       Proposal[]
  delegations     Delegation[]
  conclusions     Conclusion[]
  statistic       CaseStatistic? // Thống kê mở rộng (hybrid — số/ngày/bool báo cáo, query được cho KPI)
  supplements     InvestigationSupplement[]
  vksMeetings     VksMeetingRecord[]
  actionPlans     SuspensionActionPlan[]

  // v0.44 — Ủy Thác Điều Tra fields (nullable, chỉ relevant khi caseType = UY_THAC_DIEU_TRA)
  caseType          CaseType    @default(REGULAR) @map("case_type")
  legacySourceId    String? // Khóa gốc hệ thống cũ — idempotent di trú
  soHoSoCu          String? // STT thụ lý hệ cũ (trường `stt`) — truy nguyên (hiển thị + tìm kiếm)
  sttCu             String? // STT cũ hơn (trường `stt_cu`) — hiển thị + tìm kiếm
  /// Số suy từ mã hồ sơ để SẮP danh sách — do trigger của cơ sở dữ liệu giữ, mã ứng dụng
  /// không bao giờ ghi. Mã là chuỗi "2026-11171" nên sắp thẳng trên nó ra sai thứ tự.
  sttSort          BigInt?
  legacyId          Int? // id số gốc hệ cũ (kèm legacyCollection vì id trùng giữa collection)
  legacyCollection  String? // collection gốc: ho_so | ho_so_doi_1
  donViGiao         String?     @map("don_vi_giao") // Tên CQĐT/đơn vị ủy thác (PC01, CA quận X...)
  soQuyetDinhUyThac String?     @unique @map("so_quyet_dinh_uy_thac") // Số QĐ/Phiếu ủy thác từ đơn vị giao (Mẫu 58 TT119/2021) — unique (NULL cho phép trùng theo chuẩn PG)
  ngayTiepNhan      DateTime?   @map("ngay_tiep_nhan") // Ngày tiếp nhận theo biên bản
  thoiHanUyThac     DateTime?   @map("thoi_han_uy_thac") // Thời hạn thực hiện do đơn vị giao yêu cầu
  loaiUyThac        LoaiUyThac? @map("loai_uy_thac") // Loại ủy thác (closed-set enum)
  ketQuaUyThac      String?     @map("ket_qua_uy_thac") // Kết quả điều tra
  ngayTraKetQua     DateTime?   @map("ngay_tra_ket_qua") // Ngày trả kết quả về đơn vị ủy thác
  loaiThongTin      String?     @map("loai_thong_tin") // Tố giác / Trình báo / Đề nghị / Kiến nghị...

  // Field-parity hệ thống cũ (PR-M2): ghi chú tự do + tội danh khác cấp vụ án (multi).
  ghiChuKhac     String?  @map("ghi_chu_khac") // old: ghi_chu_khac
  toiDanhKhacIds String[] @default([]) @map("toi_danh_khac_ids") // old: toi_danh_khac[] — FK crimes id (multi)

  // Field-parity đầy đủ (feat/legacy-field-parity): promote field intake hệ cũ (trước ở metadata) → cột typed.
  ngayDeXuat             DateTime? // old: ngay_de_xuat
  moTaChiTiet            String? // old: tom_tat_noi_dung (toàn văn; name = tiêu đề rút gọn)
  nguonDon               String? // old: nguon_don
  tenCungCap             String? // old: ten_ca_nhan_co_quan_to_chuc_cung_cap
  sinhNamCungCap         String? // old: sinh_nam_nguoi_to_giac
  cccdCungCap            String? // old: so_cccd_nguyen_don
  ngayCapCccd            DateTime? // old: ngay_cap_cccd_nguyen_don
  noiCapCccd             String? // old: noi_cap_cccd_nguyen_don
  sdtCungCap             String? // old: so_dien_thoai_nguyen_don
  diaChiCungCap          String? // old: dia-chi-bi-hai
  nghiVanDoiTuong        String? // old: nghi_van_doi_tuong
  nhanXet                String? // old: nhan_xet
  noiXayRa               String? // old: noi_xay_ra
  phuongThucThuDoan      String? // old: phuong_thuc_thu_doan
  ketQuaXuLyKhac         String? // old: ket_qua_xu_ly_giai_quyet_khac
  soPhieuChuyen          String? // old: so_phieu_chuyen
  ngayPhieuChuyen        DateTime? // old: ngay_phieu_chuyen
  doVatTaiLieuKemTheo    String? // old: do_vat_tai_lieu_kem_theo
  ngayVietDon            DateTime? // old: ngay_viet_don
  ghiChuTrungDon         String? // old: ghi_chu_trung_don
  baoCaoBanGiamDoc       Boolean? // old: truong_hop_bao_cao_ban_giam_doc
  ngayGiaoDonViGiaiQuyet DateTime? // old: ngay_giao_don_vi_giai_quyet
  lanhDaoToTung          String? // old: lanh_dao_to_tung
  dieuTraVien            String? // old: dieu_tra_vien
  phanLoaiToiPhamLinhVuc String? // old: phan_loai_toi_pham_theo_linh_vuc
  phanLoaiHoSoNoiBo      String? // old: phan_loai_ho_so_doi_1
  deXuat                 String? // old: de_xuat
  yeuCauBoSung           String? // old: yeu_cau_bo_sung

  // ── Consolidate epic (feat/consolidate-legacy-native-fields): native metadata → cột typed ──
  // Trước đây các field này chỉ nằm trong Case.metadata JSON (không query được). Thăng thành
  // cột chính thức: canonical store 1 nơi, queryable. Xem plan A0 (loại N).
  reporterDateOfBirth          DateTime? // Ngày sinh người tố cáo/báo tin (gộp từ sinhNamCungCap year-only)
  reporterDateOfBirthPrecision String? // 'year' | 'date' — sinhNamCungCap cũ chỉ có năm → YYYY-01-01 + precision='year'
  receiveDate                  DateTime? // Ngày tiếp nhận vụ án (nghiệp vụ; KHÁC ngayTiepNhan của UTDT)
  caseClassification           String? // Phân loại vụ án (native)
  tinhTrang                    String? // Tình trạng hồ sơ (native)
  toiDanhBanDau                String? // Tội danh ban đầu (native, cạnh cụm tội danh)

  // ── Ô hệ cũ còn thiếu cột, bổ sung để form khớp bố cục /doi-1/Them (26/08/2026) ──
  // Trước đây chúng nằm trong `metadata` hoặc chỉ còn trong `legacy_raw`, nên form hệ mới
  // không có chỗ nhập và cán bộ mất luôn thông tin khi sửa hồ sơ.
  phanLoaiNguonTinBanDau String? // Phân loại ban đầu (phan_loai_nguon_tin_ban_dau)
  // Chữ ĐƠN VỊ GIẢI QUYẾT y như cán bộ nhìn thấy bên hệ cũ. `assignedTeamId` giữ id tổ do
  // bộ nạp phân giải ra, nhưng phân giải là suy đoán còn chữ gốc là chứng cứ — 3.286 vụ án
  // có chữ ấy, và Đơn thư lẫn Vụ việc đều đã có cột này từ trước.
  donViGiaiQuyet         String?
  ngayXayRa              DateTime? // Ngày tội phạm xảy ra — 17.388 hồ sơ có dữ liệu
  noiXayRaPhuongXa       String? // Nơi xảy ra (cấp phường/xã)
  baoCaoBanGiamDocText   String? // Nội dung chỉ đạo Ban Giám đốc — cột Boolean cạnh bên chỉ ghi CÓ/KHÔNG

  // Tab "Vụ việc" hệ cũ
  soQDPhanCongNguonTin   String?
  ngayQDPhanCongNguonTin DateTime?
  soQDKhongKhoiTo        String?
  ngayQDKhongKhoiTo      DateTime?
  canCuKhongKhoiTo       String?
  lyDoKhongKhoiTo        String[] // BLTTHS Đ.157, chọn nhiều
  chuyenVuViecDonViKhac  String?
  nhapVaoVuViecSo        String?
  phanLoaiDanSu          String?

  // Tab "Vụ việc TĐC" hệ cũ
  vuViecTamDungTruoc2015   Boolean?
  soQDTamDinhChiNguonTin   String?
  ngayQDTamDinhChiNguonTin DateTime?
  canCuTamDinhChiNguonTin  String?
  lyDoTamDinhChiNguonTin   String[] // BLTTHS Đ.148, chọn nhiều
  ngayHetThoiHieuVuViec    DateTime?
  khacPhucLyDoTDCVuViec    String?
  tienDoKhacPhucTDCVuViec  String?
  soPhucHoiNguonTin        String?
  ngayPhucHoiNguonTin      DateTime?

  // Tab "Vật chứng" hệ cũ — ba ô chữ, khác bảng vật chứng chuẩn hoá của hệ mới.
  // Giữ song song: hệ cũ nhập tự do, hệ mới có bảng Evidence từng món.
  vatChungMoTa     String?
  lenhNhapKho      String?
  noiLuuTruBaoQuan String?

  // Tội danh chính KHI KHỞI TỐ — khác tội danh nhận định ban đầu (`crimeChinhId`).
  // Hệ cũ có hai ô riêng; bản di trú trước gộp làm một nên mất phân biệt.
  toiDanhChinhKhoiToId String?
  toiDanhChinhKhoiTo   Crime?  @relation("CaseCrimeKhoiTo", fields: [toiDanhChinhKhoiToId], references: [id], onDelete: SetNull)

  legacyRaw Json? @map("legacy_raw") // Toàn bộ field raw hệ cũ — không bao giờ mất data (Codex P1)

  // PR1 ListPageShell — composite cho /cases/stats hot path (groupBy status,
  // base predicate deletedAt + caseType). Migration 20260530000001 tạo
  // partial index `WHERE "deletedAt" IS NULL` — Prisma `@@index` không express
  // được partial predicate → KHÔNG declare ở đây. Migration SQL là source
  // of truth (raw SQL CREATE INDEX với WHERE clause). Future `prisma migrate
  // diff` sẽ skip diff cho partial index theo Prisma limitation.
  @@unique([legacySourceId]) // Codex P1#2: unique để upsert thật theo khóa gốc (Postgres cho nhiều NULL)
  @@index([status])
  @@index([deadline])
  @@index([deletedAt])
  @@index([assignedTeamId])
  @@index([createdAt])
  @@index([unit])
  @@index([createdById])
  @@index([caseProvenance]) // v0.37.1
  @@index([linkedPetitionId]) // v0.37.1
  @@index([linkedIncidentId]) // v0.37.1
  @@index([caseType]) // v0.44
  @@index([thoiHanUyThac]) // v0.44
  @@index([donViGiao]) // v0.44
  @@index([soHoSoCu])
  @@index([toiDanhChinhKhoiToId]) // truy nguyên hệ cũ
  @@index([sttCu])
  @@index([legacyId, legacyCollection])
  @@map("cases")
}

// ─────────────────────────────────────────────
// CaseStatistic — Thống kê mở rộng (HYBRID): số/ngày/bool BÁO CÁO được lưu cột thật để KPI
// tổng hợp/lọc. (48 stat cũ vẫn ở Case.metadata JSON — không migrate lần này.) 1-1 với Case.
// ─────────────────────────────────────────────
model CaseStatistic {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Hồ sơ nghiệp vụ
  soDangKyHoSo     String?
  ngayDangKyHoSo   DateTime?
  hoSoLuu          String?
  ngayNopLuuHoSo   DateTime?
  donViBaoQuanHoSo String?

  // Ghi âm, ghi hình
  coGhiAmGhiHinh              Boolean @default(false)
  tongSoBienBanGhiLoiKhai     Int?
  soBienBanGhiLoiKhaiCoGhiAm  Int?
  laVuAnGhiAmGhiHinh          Boolean @default(false)
  tongSoBienBanHoiCung        Int?
  tongSoBienBanHoiCungCoGhiAm Int?
  soBiCanCoGhiAm              Int?
  vksYeuCauGhiAm              Boolean @default(false)
  soBiCanVksYeuCauGhiAm       Int?

  // Vi phạm hành chính (VPHC)
  coVPHC                Boolean @default(false)
  soDoiTuongVPHC        Int?
  soNguoiBiPhatTien     Int?
  tongTienPhatHanhChinh Float?

  // Đối tượng / vũ khí / băng nhóm
  soDoiTuong               Int? // PR-7: TỔNG số đối tượng (old: so_doi_tuong — khác soDoiTuongDaBat)
  soDoiTuongDaBat          Int?
  soDoiTuongBiBatVuAnKhac  Int?
  dieuTraMoRong            Int?
  suDungVuKhiNong          String?
  coBangNhom               Boolean @default(false)
  soBangNhom               Int? // PR-7: SỐ LƯỢNG băng nhóm (old: co_bao_nhieu_bang_nhom — khác bool coBangNhom)
  soBangNhomBatDuoc        Int?
  soSungThuHoi             Int?
  soThuocNoThuHoi          Int?
  soDoiTuongSuuTraHiemNghi Int?

  // Field-parity hệ thống cũ — bị hại, thiệt hại, xét xử
  soLuongBiHai              Int? // Số lượng bị hại (old: so_luong_bi_hai)
  soNguoiBiThuong           Int? // Số người bị thương (old: so_nguoi_bi_thuong)
  soLuongNguoiChet          Int? // Số lượng người chết (old: so_luong_nguoi_chet)
  soTienBiThietHai          Float? // Số tiền bị thiệt hại VND (old: so_tien_bi_thiet_hai)
  soTienThuHoi              Float? // Số tiền thu hồi VND (old: so_tien_thu_hoi)
  vuAnDaDuocXetXu           Boolean  @default(false) // Vụ án đã được xét xử (old: xac_nhan_vu_an_da_duoc_xet_xu)
  // Codex P1#9: 3 cờ xét-xử RIÊNG (KHÔNG reuse vuAnDaDuocXetXu/coGhiAmGhiHinh — khác ngữ nghĩa).
  // Codex P1#6: nullable để phân biệt "thiếu ở legacy" vs false.
  ghiAmGhiHinhDaDuocXetXu   Boolean? // old: ghi_am_ghi_hinh_da_duoc_xet_xu
  coSuDungKQGhiAmTrongXetXu Boolean? // old: vu_an_co_su_dung_kqghi_am_trong_xet_xu
  khongGAGHNhungToaYeuCau   Boolean? // old: vu_an_khong_gagh_nhung_toa_yeu_cau

  // Mốc thời gian thống kê
  ngayThongKe                 DateTime?
  ngayPhanCongGiaiQuyetToGiac DateTime?
  ngayTiepNhanTin             DateTime?
  ngayDauThu                  DateTime?
  ngayPhamToiQuaTang          DateTime?
  ngayBatKhanCap              DateTime?
  ngayPhatHienDauHieu         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_statistics")
}

// ─────────────────────────────────────────────
// Subjects (Đối tượng)
// ─────────────────────────────────────────────

enum SubjectStatus {
  INVESTIGATING // Đang điều tra
  DETAINED // Đang tạm giam
  RELEASED // Đã thả
  WANTED // Đang truy nã

  @@map("subject_status")
}

enum SubjectType {
  SUSPECT // Bị can / Bị cáo
  VICTIM // Bị hại
  WITNESS // Nhân chứng

  @@map("subject_type")
}

model Subject {
  id            String        @id @default(cuid())
  fullName      String
  // Nullable: dữ liệu cũ nhiều nghi can/bị hại CHỈ có tên (không SN/CCCD/địa chỉ). "Có gì điền đó" —
  // để trống trung thực hơn bịa. Form nhập tay vẫn bắt buộc qua create-subject.dto.ts.
  dateOfBirth   DateTime?
  gender        String        @default("MALE") // "MALE" | "FEMALE" | "OTHER"
  idNumber      String? // CCCD/CMND 9 or 12 digits (unique per type per case khi có giá trị)
  address       String?
  phone         String?
  occupationId  String? // FK → directories (type=OCCUPATION)
  nationalityId String? // FK → directories (type=NATIONALITY)
  districtId    String? // FK → directories (type=DISTRICT) — legacy only
  wardId        String? // FK → directories (type=WARD)
  districtName  String? // denormalized: "Quận 1" — preserved at creation time for post-reform display
  caseId        String // FK → cases (required)
  crimeId       String? // FK → crimes (master Tội danh) — optional: nhân chứng/bị hại không cần tội danh
  type          SubjectType   @default(SUSPECT) // TASK-2026-261225
  status        SubjectStatus @default(INVESTIGATING)
  notes         String?
  deletedAt     DateTime? // Soft delete
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Truy nguyên di trú (nghi can/bị hại bóc từ ho_so_doi_1.nghi_van_doi_tuong)
  legacySourceId   String? // Khóa gốc hệ cũ (idempotent)
  legacyId         Int? // id hồ sơ gốc chứa đối tượng
  legacyCollection String? // collection gốc: ho_so | ho_so_doi_1
  legacyRaw        Json? // Chuỗi gốc trích ra (nghi_van_doi_tuong) — không mất data

  case    Case     @relation(fields: [caseId], references: [id])
  crime   Crime?   @relation(fields: [crimeId], references: [id]) // FK thật → master Crime (optional)
  lawyers Lawyer[] // Lawyers assigned to this subject

  @@index([caseId])
  @@index([crimeId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@index([legacySourceId])
  @@map("subjects")
}

// ─────────────────────────────────────────────
// Lawyer (Luật sư) — TASK-2026-261225
// ─────────────────────────────────────────────

model Lawyer {
  id        String    @id @default(cuid())
  fullName  String
  lawFirm   String? // Văn phòng luật sư
  barNumber String    @unique // Số thẻ luật sư
  phone     String?
  caseId    String // FK → cases (required)
  subjectId String? // FK → subjects (nullable — one lawyer can defend multiple)
  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Di trú (Codex P1#3): idempotent + raw
  legacySourceId String? @unique // Khóa gốc hệ thống cũ — idempotent
  legacyRaw      Json? // Toàn bộ field raw hệ cũ — không mất data

  case    Case     @relation(fields: [caseId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([subjectId])
  @@index([deletedAt])
  @@map("lawyers")
}

// ─────────────────────────────────────────────
// Petition (Đơn thư KNTC) — TASK-2026-260202
// ─────────────────────────────────────────────

enum PetitionStatus {
  MOI_TIEP_NHAN // Mới tiếp nhận
  DANG_XU_LY // Đang xử lý
  CHO_PHE_DUYET // Chờ phê duyệt
  DA_LUU_DON // Đã lưu đơn
  DA_GIAI_QUYET // Đã giải quyết
  DA_CHUYEN_VU_VIEC // Đã chuyển thành Vụ việc
  DA_CHUYEN_VU_AN // Đã chuyển thành Vụ án

  @@map("petition_status")
}

model Petition {
  id               String         @id @default(cuid())
  // Số tiếp nhận — duy nhất, format: DT-{YEAR}-{SEQ}
  stt              String         @unique
  // Ngày tiếp nhận
  receivedDate     DateTime
  /// CHỈ ĐỌC — cột SINH TỰ ĐỘNG trong CSDL, KHÔNG BAO GIỜ ghi vào trường này.
  /// Bằng `receivedDate` khi ngày nằm trong khoảng 1900–2100, ngược lại là NULL.
  /// Mục đích: 9 hồ sơ có ngày phi lý (năm 3023, 2925, 0225...) chìm xuống cuối khi
  /// sắp giảm dần, thay vì chiếm trọn màn hình đầu của danh sách 45.459 đơn thư.
  /// Prisma không có cú pháp cho cột sinh — định nghĩa thật nằm ở migration
  /// 20260824120000_list_sort_by_receipt_date. Khai ở đây chỉ để dùng được trong orderBy.
  /// Số suy từ mã hồ sơ để SẮP danh sách — do trigger của cơ sở dữ liệu giữ, mã ứng dụng
  /// không bao giờ ghi. Mã là chuỗi "2026-11171" nên sắp thẳng trên nó ra sai thứ tự.
  sttSort          BigInt?
  sortReceivedDate DateTime?
  // Đơn vị tiếp nhận
  unit             String?
  // Người nhập
  enteredById      String? // FK → users
  // Người gửi đơn
  senderName       String
  senderBirthYear  String?
  senderAddress    String?
  senderPhone      String?
  senderEmail      String?
  // Nghi vấn đối tượng
  suspectedPerson  String?
  suspectedAddress String?
  // Nội dung đơn
  petitionType     LoaiDon? // Loại đơn (Luật Tố cáo 2018 / Khiếu nại 2011)
  priority         String? // Mức độ ưu tiên: Cao, Trung bình, Thấp
  summary          String?
  detailContent    String?
  attachmentsNote  String? // Ghi chú tài liệu đính kèm (text bổ sung; file thực ở model Document — v0.52)
  // Phân công
  deadline         DateTime?
  assignedToId     String? // FK → users
  // Cán bộ ĐỀ XUẤT — người ký mục "Cán bộ đề xuất" trên Phiếu đề xuất.
  // Mặc định = người tạo đơn nhưng CHO PHÉP chọn cán bộ khác (khác assignedToId
  // là quyết định phân công, và khác enteredById bị ép = actor chống giả mạo).
  canBoDeXuatId    String? // FK → users
  notes            String?
  // Trạng thái
  status           PetitionStatus @default(MOI_TIEP_NHAN)
  // Liên kết sau khi chuyển đổi
  linkedCaseId     String? // FK → cases (sau khi chuyển thành Vụ án)
  linkedIncidentId String? // FK → incidents (sau khi chuyển thành Vụ việc)
  // Soft delete
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  enteredBy      User?     @relation("PetitionEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  assignedTo     User?     @relation("PetitionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  canBoDeXuat    User?     @relation("PetitionCanBoDeXuat", fields: [canBoDeXuatId], references: [id], onDelete: SetNull)
  linkedCase     Case?     @relation("PetitionLinkedCase", fields: [linkedCaseId], references: [id], onDelete: SetNull)
  linkedIncident Incident? @relation("PetitionLinkedIncident", fields: [linkedIncidentId], references: [id], onDelete: SetNull)
  // v0.37.1: reverse side of Case.linkedPetition (CaseSourcePetition relation)
  sourceForCases Case[]    @relation("CaseSourcePetition")
  assignedTeamId String?
  assignedTeam   Team?     @relation("PetitionTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)

  // Deadline Rule Versioning snapshot — rule used to compute initial deadline at creation
  deadlineRuleVersionId String?
  deadlineRuleVersion   DeadlineRuleVersion? @relation("PetitionInitialRule", fields: [deadlineRuleVersionId], references: [id], onDelete: Restrict)

  // v0.36.0.0 Phase 5-lite: warning flag (audit-only)
  editedAfterWindow Boolean @default(false)

  // v0.47 — Nội dung nghiệp vụ cho Document Template Engine (6 doc types).
  // Free-text business fields, optional vì doc type khác nhau dùng subset khác nhau.
  // No flat docNumber cache columns (use DocumentNumberLog) and no audit columns
  // per docType (use DocumentRenderLog) — superseded plan decisions CQ2 + CQ3.
  nhanThay         String? // "Nhận thấy:" — đánh giá của cán bộ (Phiếu đề xuất)
  deXuat           String? // "Đề xuất xử lý:" — Phiếu đề xuất
  raSoatTrung      String? // "Kết quả rà soát đơn/vụ trùng" — Phiếu đề xuất
  baoCaoBanGiamDoc Boolean   @default(false) // "Báo cáo Ban Giám đốc" — Phiếu đề xuất
  petitionDate     DateTime? // Ngày ghi trên đơn (khác receivedDate = ngày tiếp nhận)
  nguonDon         String? // Nguồn đơn (Trại tạm giam X, công an phường Y...) — khác senderAddress
  subTeamAssigned  String? // "Tổ công tác Số X" (free text, có thể FK hóa sau)
  lyDoChuyen       String? // Lý do chuyển — Phiếu chuyển (#2, #3)
  canCuPhapLy      String? // Căn cứ pháp lý chuyển (BLTTHS Đ.36/145/146) — Phiếu chuyển nguồn tin
  huongDanKhoiKien String? // Hướng dẫn khởi kiện — Thông báo hướng dẫn (#5)
  lyDoTraDon       String? // Lý do trả lại đơn — Thông báo trả đơn (#6)

  // ── Field-parity hệ thống cũ pc02hcm.com (giai đoạn tiếp nhận đơn) ──
  senderIdNumber         String? // Số CCCD nguyên đơn
  senderIdIssueDate      DateTime? // Ngày cấp CCCD
  senderIdIssuePlace     String? // Nơi cấp CCCD
  senderIsAnonymous      Boolean   @default(false) // Đơn nặc danh — bỏ qua required senderPhone/crimeChinhId
  loaiThongTin           String? // Loại thông tin (tố giác/trình báo/kiến nghị/phản ánh/khiếu nại...)
  soPhieuChuyen          String? // Số phiếu chuyển/công văn/UTĐT
  ngayPhieuChuyen        DateTime? // Ngày phiếu chuyển
  ngayTiepNhanNguonTin   DateTime? // Ngày tiếp nhận theo biên bản nguồn tin (khác receivedDate)
  toiDanhBanDau          String? // Tội danh cũ trước đây (free text — legacy label)
  crimeChinhId           String? // FK → crimes (master Tội danh BLHS 2015) — tội danh chính
  noiXayRa               String? // Nơi xảy ra tội phạm
  noiXayRaPhuongXa       String? // Nơi xảy ra (phường/xã) — chi tiết hơn noiXayRa
  ngayXayRa              DateTime? // Ngày xảy ra tội phạm/sự việc
  loaiToiPham            String? // Loại tội phạm: TTXH / Kinh tế-Ma túy / Khác
  phuongThucThuDoan      String? // Phương thức, thủ đoạn phạm tội (free text)
  ngayGiaoDonViGiaiQuyet DateTime? // Ngày giao đơn vị giải quyết
  laCongNgheCao          Boolean   @default(false) // Tội phạm công nghệ cao
  lanhDaoToTung          String? // Lãnh đạo phụ trách tố tụng
  ketQuaXuLyKhac         String? // Kết quả xử lý, giải quyết khác
  // ── Field-parity bổ sung tab "Thông tin" form cũ /doi-1/Them (2026-06-26) ──
  ngayDeXuat             DateTime? // Ngày đề xuất (old: ngay_de_xuat) — khác receivedDate/petitionDate
  phanLoaiNguonTin       String? // Phân loại nguồn tin ban đầu (old: phan_loai_nguon_tin_ban_dau — discriminator)
  dieuTraVien            String? // Điều tra viên thụ lý (old: dieu_tra_vien — free text, pattern như lanhDaoToTung)
  donViGiaiQuyet         String? // Đơn vị giải quyết (old: don_vi_giai_quyet — khác unit="Đơn vị tiếp nhận")

  // ── Ô hệ cũ đưa về đúng vị trí trên form Đơn thư (26/08/2026) ──
  // Số hồ sơ THẬT có dữ liệu, đo trên máy chạy (đã loại rỗng và hai mốc rỗng "0"/"-25200").
  // Ma trận tài liệu đếm theo SỰ CÓ MẶT của khoá nên cao hơn thực tế — bám số đo, không bám
  // ma trận (vd ngay_thong_ke: ma trận báo 126, thực tế 1 hồ sơ).
  baoCaoBanGiamDocText     String? // 35.261 — chữ tự do; cột Boolean cạnh bên chỉ giữ CÓ/KHÔNG
  tinhTrang                String? // 15.039 — old: tinh_trang
  soQDPhanCongNguonTin     String? // 411 — old: quyet_dinh_phan_cong_giai_quyet_nguon_tin
  ngayQDPhanCongNguonTin   DateTime? // 412 — old: ngay_ra_quyet_dinh_phan_cong_tin_bao
  soQDTamDinhChiNguonTin   String? // 58 — old: quyet_dinh_tam_dinh_chi_nguon_tin
  ngayQDTamDinhChiNguonTin DateTime? // 62 — old: ngay_ra_quyet_dinh_tam_dinh_chi_nguon_tin
  canCuTamDinhChiNguonTin  String? // 54 — old: can_cu_tam_dinh_chi_nguon_tin
  soPhucHoiNguonTin        String? // 48 — old: phuc_hoi_nguon_tin_toi_pham
  ngayPhucHoiNguonTin      DateTime? // 48 — old: ngay_phuc_hoi_nguon_tin_toi_pham
  legacySourceId           String? // Khóa gốc hệ thống cũ pc02hcm.com — idempotent di trú
  soHoSoCu                 String? // STT thụ lý hệ cũ (trường `stt`) — truy nguyên
  sttCu                    String? // STT cũ hơn (trường `stt_cu`)
  legacyId                 Int? // id số gốc hệ cũ (kèm legacyCollection)
  legacyCollection         String? // collection gốc: ho_so | ho_so_doi_1
  legacyRaw                Json? // Toàn bộ field raw hệ cũ — không mất data (Codex P1#1)
  metadata                 Json? // Field hệ cũ dạng cấu trúc (mọi field tương ứng) — surface + editable
  // Field-parity hệ thống cũ — giai đoạn Ủy thác điều tra
  thoiHanUTDT              DateTime? // Thời hạn thực hiện Ủy thác điều tra (old: thoi_han_thuc_hien_uy_thac_dieu_tra)
  // Thẩm quyền & đơn vị xử lý (form đăng ký đơn thư)
  thuocThamQuyen           Boolean   @default(true) // Đơn thuộc thẩm quyền → xử lý nội bộ theo Tổ/Nhóm (assignedTeamId); false → chuyển đơn vị xử lý ngoài
  donViXuLy                String? // Tên đơn vị xử lý (danh mục DON_VI) khi KHÔNG thuộc thẩm quyền

  // Field-parity đầy đủ (feat/legacy-field-parity): field hệ cũ chưa có cột typed trên Đơn thư.
  phanLoaiToiPhamLinhVuc String? // old: phan_loai_toi_pham_theo_linh_vuc
  phanLoaiHoSoNoiBo      String? // old: phan_loai_ho_so_doi_1
  ghiChuKhac             String? // old: ghi_chu_khac
  yeuCauBoSung           String? // old: yeu_cau_bo_sung
  soTienBiThietHai       Float? // old: so_tien_bi_thiet_hai (tiền VND — Float tránh tràn Int)
  soLuongBiHai           Int? // old: so_luong_bi_hai

  crimeChinh Crime? @relation("PetitionCrimeChinh", fields: [crimeChinhId], references: [id], onDelete: SetNull)

  // v0.47 — DocumentRenderLog reverse relation (audit trail per render).
  renderLogs DocumentRenderLog[]

  // v0.52 — File attachments (real file storage, replaces text-only attachmentsNote field).
  documents Document[]

  // Nhóm I — phân công nhiều cán bộ
  assignments PetitionAssignment[]

  @@unique([legacySourceId]) // Codex P1#2: unique để upsert thật theo khóa gốc
  @@index([status])
  @@index([receivedDate])
  @@index([deadline])
  @@index([senderName])
  @@index([deletedAt])
  @@index([assignedTeamId])
  @@index([deadlineRuleVersionId])
  @@index([crimeChinhId])
  @@index([soHoSoCu]) // truy nguyên hệ cũ
  @@index([sttCu])
  @@index([legacyId, legacyCollection])
  @@map("petitions")
}

// ─────────────────────────────────────────────
// PetitionAssignment — Nhóm I phân công nhiều cán bộ
// ─────────────────────────────────────────────
model PetitionAssignment {
  id           String   @id @default(cuid())
  petitionId   String
  petition     Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("PetitionAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role         String // 'LEAD' | 'SUPPORT'
  assignedById String
  assignedBy   User     @relation("PetitionAssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([petitionId, userId])
  @@index([petitionId])
  @@map("petition_assignments")
}

// ─────────────────────────────────────────────
// Incident (Vụ việc) — TASK-2026-260202
// ─────────────────────────────────────────────

enum IncidentStatus {
  TIEP_NHAN // Tiếp nhận
  DANG_XAC_MINH // Đang xác minh
  DA_PHAN_CONG // Đã lên phân công
  DA_GIAI_QUYET // Đã giải quyết
  TAM_DINH_CHI // Tạm đình chỉ
  QUA_HAN // Quá hạn
  DA_CHUYEN_VU_AN // Đã chuyển thành vụ án (khởi tố)
  KHONG_KHOI_TO // Không khởi tố
  CHUYEN_XPHC // Chuyển xử phạt hành chính
  TDC_HET_THOI_HIEU // TĐC hết thời hiệu
  TDC_HTH_KHONG_KT // TĐC hết thời hạn không khởi tố
  PHUC_HOI_NGUON_TIN // Phục hồi nguồn tin tố phạm
  DA_CHUYEN_DON_VI // Đã chuyển đơn vị khác
  DA_NHAP_VU_KHAC // Đã nhập vào vụ việc khác
  PHAN_LOAI_DAN_SU // Phân loại dân sự

  @@map("incident_status")
}

model Incident {
  id               String         @id @default(cuid())
  code             String         @unique // VV-{YEAR}-{SEQ}
  name             String
  incidentType     String? // Loại vụ việc
  description      String?
  fromDate         DateTime? // Ngày bắt đầu vụ việc
  toDate           DateTime? // Ngày xảy ra/kết thúc vụ việc
  deadline         DateTime? // Hạn xử lý
  unitId           String? // ID đơn vị thụ lý
  investigatorId   String? // ID Điều tra viên thụ lý
  status           IncidentStatus @default(TIEP_NHAN)
  sourcePetitionId String? // Nguồn gốc nếu từ đơn thư

  // Thông tin nguồn tin (Đ.144 BLTTHS 2015)
  doiTuongCaNhan     String? // Đối tượng bị tố giác (TT119 Mẫu 01)
  doiTuongToChuc     String? // Tổ chức liên quan
  loaiDonVu          LoaiNguonTin? // Loại nguồn tin (Điều 144 BLTTHS 2015)
  nguonPhatTin       NguonPhatTin? // Sub-type cascading từ loaiDonVu (Đ.144 BLTTHS) — v0.31.0.0
  phuongThucTiepNhan PhuongThucTiepNhan? // Phương thức tiếp nhận (TT 28/2020/TT-BCA Đ.6) — v0.31.0.0
  benVu              String? // Người tố giác/báo tin (Đ.144 BLTTHS)
  donViGiaiQuyet     String? // Đơn vị thụ lý (Đ.145 BLTTHS)
  ngayDeXuat         DateTime? // Ngày tiếp nhận nguồn tin (Đ.146 BLTTHS)
  ketQuaXuLy         String? // Kết quả giải quyết nguồn tin (free-form text, mô tả chi tiết)
  // PR 5 v0.38.4.0: loại kết quả chuẩn hóa cho reporting + entry path 3 detection
  // Wireframe 5 — anh confirm trong session twinkly-crescent
  loaiKetQua         String? // KHOI_TO | KHONG_KHOI_TO | TAM_DINH_CHI | CHUYEN_HO_SO | DINH_CHI | KHAC
  // PR 5: Căn cứ khởi tố vụ án (Đ.143 BLTTHS) — optional, code khớp CaseProvenance enum
  // Khi convert Incident → Case, value transfer sang Case.caseProvenance
  canCuKhoiToCode    String? // ref Directory(type=CAN_CU_KHOI_TO, code) — em đã seed 7 entries
  tinhTrangHoSo      String? // Tình trạng hồ sơ
  tinhTrangThoiHieu  String? // Tình trạng thời hiệu truy cứu TNHS
  nguoiQuyetDinh     String? // Người ra quyết định (Thủ trưởng/Phó TT CQĐT)
  chuyenDenDonVi     String? // Đơn vị được chuyển đến
  chuyenTuDonVi      String? // Đơn vị chuyển đi (audit trail)

  // Thông tin nghiệp vụ bổ sung theo BLTTHS
  soQuyetDinh             String? // Số quyết định (khởi tố/không khởi tố/TĐC/phục hồi)
  ngayQuyetDinh           DateTime? // Ngày ra quyết định
  // Field-parity hệ thống cũ (giai đoạn nguồn tin/vụ việc)
  soQDPhanCongNguonTin    String? // Số QĐ phân công giải quyết nguồn tin tội phạm
  ngayQDPhanCongNguonTin  DateTime? // Ngày ra QĐ phân công giải quyết nguồn tin
  canCuKhongKhoiTo        String? // Căn cứ (text) ra QĐ không khởi tố — bổ trợ enum lyDoKhongKhoiTo
  // PR-6 field-parity: QĐ không khởi tố RIÊNG (cũ tách số/ngày, khác soQuyetDinh chung) + cờ tạm dừng
  soQDKhongKhoiTo         String? // Số QĐ không khởi tố (old: quyet_dinh_khong_khoi_to)
  ngayQDKhongKhoiTo       DateTime? // Ngày QĐ không khởi tố (old: ngay_ra_quyet_dinh_khong_khoi_to)
  xacDinhVuViecTamDung    Boolean                @default(false) // Cờ xác định vụ việc tạm dừng giải quyết (old: xac_dinh_vu_viec_tam_dung_giai_quyet)
  canCuTamDinhChi         String? // Căn cứ (text) tạm đình chỉ nguồn tin
  phanLoaiDanSuText       String? // Thông báo phân loại dân sự (số/ngày)
  soLanGiaHan             Int                    @default(0) // Số lần đã gia hạn, tối đa 2 (Điều 147 khoản 2-3)
  ngayGiaHan              DateTime? // Ngày gia hạn gần nhất
  lyDoKhongKhoiTo         LyDoKhongKhoiTo[] // PR-8 MULTI: chọn nhiều căn cứ không khởi tố (Đ.157). Mảng rỗng=chưa chọn.
  lyDoTamDinhChiText      String? // Backup của giá trị String cũ trước migration
  lyDoTamDinhChiVuViec    LyDoTamDinhChiVuViec[] // PR-8 MULTI: chọn nhiều căn cứ TĐC vụ việc (Đ.148). Mảng rỗng=chưa chọn.
  laCongNgheCaoVV         Boolean                @default(false)
  soQuyetDinhTamDinhChiVV String?
  ngayTamDinhChiVV        DateTime?
  soLanTamDinhChiVV       Int                    @default(0)
  daRaSoatVV              Boolean                @default(false)
  ngayRaSoatVV            DateTime?
  soQuyetDinhPhucHoiVV    String?
  ngayPhucHoiVV           DateTime?
  ketQuaPhucHoiVuViec     KetQuaPhucHoiVuViec?
  ngayHetThoiHieuVV       DateTime? // Ngày hết thời hiệu truy cứu TNHS của vụ việc (Phụ lục 2 vs 3)
  diaChiXayRa             String? // Địa điểm xảy ra sự việc
  // Thông tin người tố giác/báo tin chi tiết
  sdtNguoiToGiac          String? // SĐT người tố giác
  diaChiNguoiToGiac       String? // Địa chỉ người tố giác
  cmndNguoiToGiac         String? // CCCD/CMND người tố giác
  sinhNamNguoiToGiac      String? // Sinh năm người tố giác/cung cấp (hệ cũ) — trước KHÔNG map

  // Field-parity đầy đủ (feat/legacy-field-parity): field intake hệ cũ Vụ việc trước CHỈ ở legacyRaw.
  nhanXet                String? // old: nhan_xet
  ngayTiepNhanNguonTin   DateTime? // old: ngay_tiep_nhan_nguon_tin
  loaiThongTin           String? // old: loai_thong_tin
  ngayVietDon            DateTime? // old: ngay_viet_don
  ghiChuTrungDon         String? // old: ghi_chu_trung_don
  baoCaoBanGiamDoc       Boolean? // old: truong_hop_bao_cao_ban_giam_doc
  ngayGiaoDonViGiaiQuyet DateTime? // old: ngay_giao_don_vi_giai_quyet
  toiDanhBanDau          String? // old: toi-danh-ban-dau

  // ── Bổ sung 27/08/2026 cho epic "form Vụ việc khớp bố cục hệ cũ" ──────────────────
  // Số hồ sơ THẬT có dữ liệu, đo trên máy chạy (đã loại rỗng và hai mốc rỗng "0"/"-25200").

  // Tội danh chính — Đơn thư và Vụ án đều có cột này từ lâu, riêng Vụ việc thì chưa, nên
  // 1.114 hồ sơ mang mã tội danh cũ không có chỗ ở và tra cứu theo tội danh sót hẳn một
  // giai đoạn tố tụng.
  crimeChinhId           String? // 1.114
  crimeChinh             Crime?    @relation("IncidentCrimeChinh", fields: [crimeChinhId], references: [id], onDelete: SetNull)

  // Phân loại ban đầu — ô thứ hai của tab Thông tin bên hệ cũ, và là ô quyết định hồ sơ nằm
  // ở danh sách nào. Không có cột thì mở hồ sơ di trú ra ô ấy trắng.
  phanLoaiNguonTinBanDau String? // 4.568 — old: phan_loai_nguon_tin_ban_dau

  // Nội dung chỉ đạo của Ban Giám đốc. Cột `baoCaoBanGiamDoc` ở trên là ĐÚNG/SAI suy từ chữ;
  // một cột một bit giữ không nổi chữ, nên phần chữ bốc hơi — cùng cách Đơn thư và Vụ án đã
  // xử bằng một cột chữ riêng.
  baoCaoBanGiamDocText   String? // 93 — old: truong_hop_bao_cao_ban_giam_doc
  soPhieuChuyen          String? // old: so_phieu_chuyen
  ngayPhieuChuyen        DateTime? // old: ngay_phieu_chuyen
  doVatTaiLieuKemTheo    String? // old: do_vat_tai_lieu_kem_theo
  phanLoaiToiPhamLinhVuc String? // old: phan_loai_toi_pham_theo_linh_vuc
  phanLoaiHoSoNoiBo      String? // old: phan_loai_ho_so_doi_1
  lanhDaoToTung          String? // old: lanh_dao_to_tung
  dieuTraVien            String? // old: dieu_tra_vien
  dieuTraVienPhuongXa    String? // old: dieu_tra_vien_phuong_xa
  noiCapCccd             String? // old: noi_cap_cccd_nguyen_don
  ngayCapCccd            DateTime? // old: ngay_cap_cccd_nguyen_don
  deXuat                 String? // old: de_xuat
  yeuCauBoSung           String? // old: yeu_cau_bo_sung
  ghiChuKhac             String? // old: ghi_chu_khac

  // Self-reference: nhập vào vụ khác
  mergedIntoId String?
  mergedInto   Incident?  @relation("IncidentMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Incident[] @relation("IncidentMerge")

  // Liên kết rõ ràng với Case sau khởi tố
  linkedCaseId String?
  linkedCase   Case?   @relation("IncidentLinkedCase", fields: [linkedCaseId], references: [id])

  // v0.37.1: reverse side of Case.linkedIncident (CaseSourceIncident relation)
  sourceForCases Case[] @relation("CaseSourceIncident")

  // Deadline Rule Versioning snapshots — set at incident creation + each gia hạn
  // - deadlineRuleVersionId: active rule used to compute initial deadline (THOI_HAN_XAC_MINH at creation)
  // - maxExtensionsSnapshot: SO_LAN_GIA_HAN_TOI_DA value at creation — frozen so admin lowering limit doesn't retroactively block
  // - giaHan1RuleVersionId / giaHan2RuleVersionId: rule used for each gia hạn (snapshot when granted)
  deadlineRuleVersionId String?
  deadlineRuleVersion   DeadlineRuleVersion? @relation("IncidentInitialRule", fields: [deadlineRuleVersionId], references: [id], onDelete: Restrict)
  maxExtensionsSnapshot Int?
  giaHan1RuleVersionId  String?
  giaHan1RuleVersion    DeadlineRuleVersion? @relation("IncidentGiaHan1Rule", fields: [giaHan1RuleVersionId], references: [id], onDelete: Restrict)
  giaHan2RuleVersionId  String?
  giaHan2RuleVersion    DeadlineRuleVersion? @relation("IncidentGiaHan2Rule", fields: [giaHan2RuleVersionId], references: [id], onDelete: Restrict)

  // Cán bộ nhập (FK)
  canBoNhapId String?
  canBoNhap   User?   @relation("IncidentCanBoNhap", fields: [canBoNhapId], references: [id])

  // Người tạo
  createdById String?
  createdBy   User?   @relation("IncidentCreatedBy", fields: [createdById], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  investigator   User?                   @relation("IncidentInvestigator", fields: [investigatorId], references: [id], onDelete: SetNull)
  assignedTeamId String?
  assignedTeam   Team?                   @relation("IncidentTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  petitions      Petition[]              @relation("PetitionLinkedIncident")
  documents      Document[] // Tài liệu liên quan
  statusHistory  IncidentStatusHistory[]
  vksMeetings    VksMeetingRecord[]      @relation("IncidentVksMeetings")
  actionPlans    SuspensionActionPlan[]  @relation("IncidentActionPlans")

  // v0.36.0.0 Phase 5-lite: warning flag (audit-only)
  editedAfterWindow Boolean @default(false)

  // v0.47 — TĐC khắc phục fields cho Phụ lục 02/03 (Vụ việc TĐC)
  tdcKhacPhucLyDoBienPhap String? // Biện pháp khắc phục lý do TĐC
  tdcKhacPhucBienBan      String? // BB trao đổi VKS, KH khắc phục (số/ngày)
  // Field-parity hệ thống cũ — tiến độ khắc phục TĐC + các fields TĐC còn thiếu
  tienDoKhacPhucTDC       String? // Tiến độ khắc phục TĐC (old: tien_do_khac_phuc_tdc)

  // v0.47 — Import audit (Track B xlsx import) — per-row provenance per Codex #3
  importedFrom     String?
  legacySourceId   String? // Khóa gốc hệ thống cũ — idempotent di trú
  soHoSoCu         String? // STT thụ lý hệ cũ (trường `stt`) — truy nguyên
  sttCu            String? // STT cũ hơn (trường `stt_cu`)
  /// Số suy từ mã hồ sơ để SẮP danh sách — do trigger của cơ sở dữ liệu giữ, mã ứng dụng
  /// không bao giờ ghi. Mã là chuỗi "2026-11171" nên sắp thẳng trên nó ra sai thứ tự.
  sttSort          BigInt?
  legacyId         Int? // id số gốc hệ cũ (kèm legacyCollection)
  legacyCollection String? // collection gốc: ho_so | ho_so_doi_1
  legacyRaw        Json? // Toàn bộ field raw hệ cũ — không mất data (Codex P1#1)
  metadata         Json? // Field hệ cũ dạng cấu trúc (mọi field tương ứng) — surface + editable
  importedAt       DateTime?
  importedById     String?
  importedBy       User?               @relation("IncidentImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  sourceFile       String?
  importLogId      String?
  importLog        XlsxImportLog?      @relation("XlsxImportLogIncidents", fields: [importLogId], references: [id], onDelete: SetNull)
  renderLogs       DocumentRenderLog[]

  @@unique([legacySourceId]) // Codex P1#2: unique để upsert thật theo khóa gốc
  @@index([status])
  @@index([deletedAt])
  @@index([assignedTeamId])
  @@index([ngayDeXuat])
  @@index([createdAt])
  @@index([unitId])
  @@index([deadlineRuleVersionId])
  @@index([giaHan1RuleVersionId])
  @@index([giaHan2RuleVersionId])
  @@index([soHoSoCu]) // truy nguyên hệ cũ
  @@index([sttCu])
  @@index([legacyId, legacyCollection])
  @@index([crimeChinhId])
  @@map("incidents")
}

// ─────────────────────────────────────────────
// Incident Status History
// ─────────────────────────────────────────────

model IncidentStatusHistory {
  id          String         @id @default(cuid())
  incidentId  String
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus  IncidentStatus
  toStatus    IncidentStatus
  changedById String
  changedBy   User           @relation("IncidentStatusChangedBy", fields: [changedById], references: [id])
  note        String? // Lý do thay đổi
  createdAt   DateTime       @default(now())

  @@index([incidentId])
  @@map("incident_status_history")
}

// ─────────────────────────────────────────────
// Document (Tài liệu/Hồ sơ) — TASK-2026-022601
// ─────────────────────────────────────────────

// DocumentType: danh mục ĐỘNG qua Catalog Registry (DOCUMENT_TYPE → bảng Directory),
// admin thêm runtime không cần deploy. Cột documentType là String, validate ở service
// qua CatalogService.isValid. Trước đây là Prisma enum document_type
// (migration 20260627000001_document_type_to_dynamic chuyển enum → TEXT).

model Document {
  id           String  @id @default(cuid())
  title        String // Tiêu đề tài liệu
  description  String? // Mô tả
  fileName     String // Tên file lưu trữ
  originalName String // Tên file gốc
  mimeType     String // MIME type
  size         Int // Kích thước file (bytes)
  filePath     String // Đường dẫn file (local storage)
  documentType String  @default("VAN_BAN") // danh mục động DOCUMENT_TYPE (Directory)

  // Liên kết
  caseId       String? // FK → cases (nullable)
  incidentId   String? // FK → incidents (nullable)
  petitionId   String? // FK → petitions (nullable) — v0.52 chain-of-custody Restrict
  uploadedById String // FK → users (required)

  // Soft delete
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  case                    Case?                 @relation(fields: [caseId], references: [id], onDelete: SetNull)
  incident                Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  // v0.52: Restrict (không SetNull như Case/Incident) — evidence integrity cho đơn thư.
  // Petition soft-delete (deletedAt) bình thường; hard-delete bị chặn nếu còn Document.
  petition                Petition?             @relation(fields: [petitionId], references: [id], onDelete: Restrict)
  uploadedBy              User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  deadlineRuleAttachments DeadlineRuleVersion[] @relation("DeadlineRuleAttachment")

  @@index([caseId])
  @@index([incidentId])
  @@index([petitionId])
  @@index([uploadedById])
  @@index([documentType])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("documents")
}

// ─────────────────────────────────────────────
// Evidence (Vật chứng) — PR 1 v0.38.0.0
// Atomic create với Case qua POST /cases (fix bug data-loss wizard "Khởi tố vụ án mới")
// Schema additive — không phá data Case cũ.
// ─────────────────────────────────────────────

model Evidence {
  id               String    @id @default(cuid())
  code             String // Mã vật chứng (vd "VC-2026-001")
  name             String // Tên vật chứng (vd "Dao Thái Lan dài 30cm")
  description      String? // Mô tả chi tiết
  quantity         Int       @default(1)
  unit             String    @default("cái") // Đơn vị (cái, kg, gram, ...)
  storageLocation  String? // Nơi lưu trữ
  receivedDate     DateTime? // Ngày thu giữ
  status           String    @default("THU_GIU") // THU_GIU | DA_GIAM_DINH | TRA_LAI | TIEU_HUY
  evidenceType     String? // Loại vật chứng (vũ khí / tang vật / tài liệu / ...)
  entryOrder       String? // Số thứ tự nhập kho
  warehouseReceipt String? // Số biên bản nhập kho
  caseId           String // FK → cases (required)
  case             Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdById      String? // FK → users (nullable for legacy backfill)
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([deletedAt])
  @@map("evidences")
}

// ─────────────────────────────────────────────
// Proposal (Đề xuất VKS) — Workflow SCR-PF-05
// ─────────────────────────────────────────────

enum ProposalStatus {
  CHO_GUI // Chờ gửi
  DA_GUI // Đã gửi
  CO_PHAN_HOI // Đã có phản hồi
  DA_XU_LY // Đã xử lý

  @@map("proposal_status")
}

model Proposal {
  id             String         @id @default(cuid())
  proposalNumber String         @unique // Format: DX-{YEAR}-{SEQ}
  relatedCaseId  String? // FK → cases (nullable)
  caseType       String? // "Vụ án" | "Vụ việc" | "Đơn thư"
  content        String // Nội dung đề xuất
  unit           String? // Đơn vị gửi
  createdById    String? // FK → users
  status         ProposalStatus @default(CHO_GUI)
  sentDate       DateTime? // Ngày gửi VKS
  response       String? // Nội dung phản hồi
  responseDate   DateTime? // Ngày có phản hồi
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Di trú (Codex P1#3): idempotent + raw
  legacySourceId String? @unique // Khóa gốc hệ thống cũ — idempotent
  legacyRaw      Json? // Toàn bộ field raw hệ cũ — không mất data

  relatedCase Case? @relation(fields: [relatedCaseId], references: [id], onDelete: SetNull)
  createdBy   User? @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([createdById])
  @@map("proposals")
}

// ─────────────────────────────────────────────
// GuidanceRecord (Hướng dẫn đơn thư) — Workflow SCR-PF-02
// ─────────────────────────────────────────────

enum GuidanceStatus {
  PENDING // Đang chờ
  COMPLETED // Đã hoàn thành
  CANCELLED // Đã hủy

  @@map("guidance_status")
}

model GuidanceRecord {
  id                String         @id @default(cuid())
  date              DateTime       @default(now())
  unit              String?
  createdById       String? // FK → users
  guidedPerson      String // Tên người được hướng dẫn
  guidedPersonPhone String? // SĐT người được hướng dẫn
  subject           String? // Chủ đề hướng dẫn
  guidanceContent   String // Nội dung hướng dẫn
  notes             String?
  status            GuidanceStatus @default(PENDING)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Di trú (Codex P1#3): idempotent + raw
  legacySourceId String? @unique // Khóa gốc hệ thống cũ — idempotent
  legacyRaw      Json? // Toàn bộ field raw hệ cũ — không mất data

  createdBy User? @relation("GuidanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
  @@map("guidance_records")
}

// ─────────────────────────────────────────────
// Exchange + ExchangeMessage (Trao đổi công văn) — Workflow SCR-PF-03
// ─────────────────────────────────────────────

enum ExchangeStatus {
  OPEN // Đang mở
  CLOSED // Đã đóng
  PENDING // Chờ xử lý

  @@map("exchange_status")
}

model Exchange {
  id           String         @id @default(cuid())
  recordCode   String? // Mã hồ sơ liên quan
  recordType   String? // "Vụ án" | "Vụ việc" | "Đơn thư"
  senderUnit   String? // Đơn vị gửi
  receiverUnit String? // Đơn vị nhận
  subject      String? // Tiêu đề trao đổi
  status       ExchangeStatus @default(OPEN)
  createdById  String? // FK → users
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Di trú (Codex P1#3): idempotent + raw
  legacySourceId String? @unique // Khóa gốc hệ thống cũ — idempotent
  legacyRaw      Json? // Toàn bộ field raw hệ cũ — không mất data

  createdBy User?             @relation("ExchangeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messages  ExchangeMessage[]

  @@index([status])
  @@index([deletedAt])
  @@map("exchanges")
}

model ExchangeMessage {
  id          String   @id @default(cuid())
  exchangeId  String // FK → exchanges
  senderId    String? // FK → users
  content     String
  attachments Json? // [{ id, name, size, type, url }]
  createdAt   DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  sender   User?    @relation("ExchangeMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([exchangeId])
  @@map("exchange_messages")
}

// ─────────────────────────────────────────────
// Delegation (Ủy thác điều tra) — Workflow SCR-PF-04
// ─────────────────────────────────────────────

enum DelegationStatus {
  PENDING // Chờ xử lý
  RECEIVED // Đã nhận
  COMPLETED // Đã hoàn thành

  @@map("delegation_status")
}

model Delegation {
  id               String           @id @default(cuid())
  delegationNumber String           @unique // Format: UT-{SEQ}/{YEAR}
  delegationDate   DateTime         @default(now())
  receivingUnit    String // Đơn vị nhận ủy thác
