// ─────────────────────────────────────────────
// Deadline Rule Versioning (BLTTHS legal compliance)
// Replaces direct SystemSetting CRUD for the 12 deadline keys with a
// propose → submit → approve → activate workflow. Incident/Petition records
// snapshot the rule version that produced their deadline so VKS audits can
// reconstruct historical state.
//
// Concurrency invariants are enforced by partial unique indexes (added in
// migration SQL): only 1 active / submitted / approved version per ruleKey
// at any time. See migration deadline_rule_versioning.
// ─────────────────────────────────────────────

enum DeadlineRuleStatus {
  draft // Bản nháp — proposer is still editing
  submitted // Đã gửi duyệt — awaiting approver
  approved // Đã duyệt, chưa hiệu lực — waiting for effectiveFrom
  active // Đang hiệu lực — current rule of record
  superseded // Đã thay thế — historical record
  rejected // Bị từ chối

  @@map("deadline_rule_status")
}

model DeadlineRuleVersion {
  id         String @id @default(cuid())
  ruleKey    String // Must match SETTINGS_KEY (THOI_HAN_XAC_MINH, etc.)
  value      Int // Always interpreted as days for THOI_HAN_*, lần for SO_LAN_*
  label      String // Vietnamese display name
  legalBasis String // E.g. "Điều 147 BLTTHS 2015"

  // Structured document reference (replaces free-text documentRef)
  documentType        String // 'TT' | 'NĐ' | 'CV' | 'QĐ' | 'BLTTHS' | 'Khác'
  documentNumber      String // E.g. "28/2020", "INITIAL"
  documentIssuer      String // 'BCA' | 'VKSNDTC' | 'TANDTC' | 'Chính phủ' | 'Khác'
  documentDate        DateTime? // Ngày ban hành (optional)
  attachmentId        String? // FK → Document model (optional, defer attachment UI to v2)
  attachment          Document? @relation("DeadlineRuleAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  documentUrl         String? // URL tham khảo văn bản pháp luật (http/https, public TLD, validated DTO+service)
  migrationConfidence String? // 'legacy-default' for migrated v1 rows; null otherwise

  reason String // Mandatory — why this change

  status        DeadlineRuleStatus @default(draft)
  effectiveFrom DateTime? // Set when approved; status='active' requires this (CHECK constraint)
  effectiveTo   DateTime? // Set when superseded

  // Self-referential supersedes chain
  supersedesId String?
  supersedes   DeadlineRuleVersion?  @relation("DeadlineRuleChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy DeadlineRuleVersion[] @relation("DeadlineRuleChain")

  // Proposer — NULLABLE to support SYSTEM migration actor
  proposedById   String?
  proposedBy     User?    @relation("DeadlineRuleProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  proposedByType String   @default("USER") // 'USER' | 'SYSTEM'
  proposedAt     DateTime @default(now())

  // Reviewer (approver or rejecter or changes-requester)
  reviewedById String?
  reviewedBy   User?     @relation("DeadlineRuleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?

  // Proposer-initiated withdraw note (separate from reviewer's reviewNotes)
  withdrawNotes String?

  // Back-relations to Incident/Petition snapshots (named — 3 FKs into Incident)
  incidentsInitial Incident[] @relation("IncidentInitialRule")
  incidentsGiaHan1 Incident[] @relation("IncidentGiaHan1Rule")
  incidentsGiaHan2 Incident[] @relation("IncidentGiaHan2Rule")
  petitionsInitial Petition[] @relation("PetitionInitialRule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleKey, status])
  @@index([ruleKey, effectiveFrom])
  @@index([status, proposedAt])
  @@index([attachmentId])
  // Partial unique indexes added via raw SQL in migration:
  //   one active per ruleKey, one submitted per ruleKey, one approved-pending per ruleKey
  //   plus CHECK (status != 'active' OR effectiveFrom IS NOT NULL)
  @@map("deadline_rule_versions")
}

