// v0.37.1 → v0.37.2 — Provenance model cho Case creation (BLTTHS Đ.143)
// v0.37.2 PROV-002 thêm 2 căn cứ pháp lý riêng (tách khỏi OTHER_LEGAL_SOURCE):
//   - SELF_SURRENDER: người phạm tội tự thú (Đ.143 điểm d)
//   - PROSECUTOR_PROPOSAL: kiến nghị khởi tố của VKS (Đ.143 điểm đ)
enum CaseProvenance {
  FROM_PETITION // Khởi tố từ Đơn thư có sẵn — yêu cầu linkedPetitionId
  FROM_INCIDENT // Khởi tố từ Vụ việc có sẵn — yêu cầu linkedIncidentId
  DIRECT_DISCOVERY // CQĐT phát hiện trực tiếp (Đ.143 điểm c)
  TRANSFERRED // Chuyển từ cơ quan khác (kèm hồ sơ ngoài hệ thống)
  SELF_SURRENDER // v0.37.2 — Người phạm tội tự thú (Đ.143 điểm d)
  PROSECUTOR_PROPOSAL // v0.37.2 — Kiến nghị khởi tố của VKS (Đ.143 điểm đ)
  OTHER_LEGAL_SOURCE // Nguồn pháp lý khác (catch-all cho căn cứ ngoài 6 mục Đ.143)
  UY_THAC_DIEU_TRA // v0.44 — Ủy thác điều tra (Điều 171 BLTTHS 2015)

  @@map("case_provenance")
}

