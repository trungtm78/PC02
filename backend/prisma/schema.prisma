  id           String          @id @default(cuid())
  loaiBaoCao   ReportTdcType
  fromDate     DateTime
  toDate       DateTime
  teamIds      String[]
  status       ReportTdcStatus @default(DRAFT)
  computedData Json
  adjustedData Json?
  notes        String?

  createdById    String
  reviewedById   String?
  approvedById   String?
  rejectedById   String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  finalizedAt    DateTime?

  createdBy  User  @relation("ReportCreatedBy", fields: [createdById], references: [id])
  reviewedBy User? @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  approvedBy User? @relation("ReportApprovedBy", fields: [approvedById], references: [id])
  rejectedBy User? @relation("ReportRejectedBy", fields: [rejectedById], references: [id])

  @@index([loaiBaoCao])
  @@index([status])
  @@index([fromDate, toDate])
  @@map("report_tdc_drafts")
}

// ─── AddressMapping — Bảng mapping địa chỉ cũ → mới (cải cách 2025) ─────────
model AddressMapping {
  id          String    @id @default(cuid())
  // Địa chỉ cũ (trước 01/07/2025 — có cấp quận/huyện)
  oldWard     String // VD: "phường 14", "xã Long Bình" (lowercase)
  oldDistrict String // VD: "quận phú nhuận", "huyện nhà bè" (lowercase)
  // Địa chỉ mới (sau cải cách 2025 — chỉ còn phường/xã + tỉnh/TP)
  newWard     String // VD: "phường phú nhuận" (lowercase)
  province    String // Province code: "HCM", "HN", v.v.
  note        String? // Ghi chú nguồn (VD: "NQ 1279/NQ-UBTVQH15")
  isActive    Boolean   @default(true)
  needsReview Boolean   @default(false) // Đánh dấu cần review sau crawl
  // Provenance & ambiguity tracking (added v0.13.10.0)
  source      String    @default("manual") // 'api-v2' | 'manual' | 'official-decree'
  seededAt    DateTime? // when the row was last touched by bulkSeedFromApi
  candidates  Json? // when needsReview, all candidate new wards from API
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([oldWard, oldDistrict, province])
  @@index([province, oldDistrict])
  @@index([needsReview])
  @@map("address_mappings")
}

// Tracks bulk-seed jobs run by admin against provinces.open-api.vn.
// Status flow: queued → running → completed | failed | cancelled
model AddressSeedJob {
  id          String    @id @default(cuid())
  province    String // 'HCM' | 'HN' | ...
  status      String // 'queued' | 'running' | 'completed' | 'failed' | 'cancelled'
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  totalWards  Int       @default(0)
  mappedCount Int       @default(0)
  errorCount  Int       @default(0)
  needsReview Int       @default(0)
  cancelToken String? // Set to 'requested' to signal worker to abort
  errorLog    String? // JSON array of {wardCode, error}
  triggeredBy String // userId

  @@index([province, status])
  @@map("address_seed_jobs")
}

// Holiday model + HolidayCategory enum REMOVED in PR 3 (v0.20.0.0).
// All 25 holiday rows migrated to CalendarEvent with scope=SYSTEM via migration
// `20260513140000_calendar_events_v2_phase3_drop_holiday`.
// See CalendarEvent + EventCategory models below for the unified schema.

// ─────────────────────────────────────────────────────────────────────────────
// Calendar Events v2 (PR 1 — schema only, gated by feature flag `calendar_events_v2`)
//
// Schema mới song song với Holiday. Holiday giữ nguyên trong PR 1.
// PR 2 implement full service/controller. PR 3 migrate data + drop Holiday.
// ─────────────────────────────────────────────────────────────────────────────

enum EventScope {
  SYSTEM // Sự kiện toàn ngành — admin tạo, mọi user thấy
  TEAM // Sự kiện cấp tổ — tổ trưởng/admin tạo, chỉ thành viên tổ thấy
  PERSONAL // Sự kiện cá nhân — user tự tạo, chỉ mình thấy
}

enum ReminderChannel {
  FCM
  EMAIL
}

model EventCategory {
  id        String   @id @default(cuid())
  slug      String   @unique // "national", "police", "military", "international", "other", ...
  name      String // "Quốc gia", "Ngành Công an", "Quân đội", ...
  color     String // hex "#DC2626"
  icon      String? // lucide icon name, optional
  isSystem  Boolean  @default(false) // true → không cho xóa (5 default categories)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@index([sortOrder])
  @@map("event_categories")
}

model CalendarEvent {
  id               String    @id @default(cuid())
  title            String
  shortTitle       String?
  description      String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date // multi-day events
  startTime        String? // "HH:MM" — null khi allDay
  endTime          String?
  allDay           Boolean   @default(true)
  isOfficialDayOff Boolean   @default(false)
  lunarDate        String?

  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  scope  EventScope
  teamId String? // required khi scope=TEAM
  team   Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String? // required khi scope=PERSONAL
  user   User?      @relation("PersonalEvents", fields: [userId], references: [id], onDelete: SetNull)

  recurrenceRule    String? // RRULE string RFC 5545, e.g. "FREQ=YEARLY"
  recurrenceEndDate DateTime? @db.Date // when to stop recurring (null = forever)

  createdById String
  createdBy   User      @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  reminders EventReminder[]
  overrides CalendarEventOccurrenceOverride[]

  @@index([startDate])
  @@index([categoryId])
  @@index([deletedAt])
  // Partial indexes added in migration SQL (Prisma doesn't support partial indexes natively)
  @@map("calendar_events")
}

// Thin override table for RFC 5545 RECURRENCE-ID + EXDATE pattern.
// Replaces self-FK `recurrenceParentId` approach (Eng review #3) — 50 bytes vs 500 per override.
model CalendarEventOccurrenceOverride {
  id             String        @id @default(cuid())
  eventId        String
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime      @db.Date // The original recurrence date being overridden
  excluded       Boolean       @default(false) // EXDATE: skip this occurrence
  overrideFields Json? // { title?, description?, startTime?, endTime?, ... }
  createdAt      DateTime      @default(now())

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
  @@map("calendar_event_occurrence_overrides")
}

model EventReminder {
  id            String            @id @default(cuid())
  eventId       String
  event         CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String // user nhận reminder
  user          User              @relation("EventReminders", fields: [userId], references: [id], onDelete: Cascade)
  minutesBefore Int // 30 = 30 phút trước, 1440 = 1 ngày, 10080 = 1 tuần
  channels      ReminderChannel[] // [FCM] | [EMAIL] | [FCM, EMAIL]
  createdAt     DateTime          @default(now())

  dispatches EventReminderDispatch[]

  @@index([eventId])
  @@index([userId])
  @@map("event_reminders")
}

model EventReminderDispatch {
  id             String            @id @default(cuid())
  reminderId     String
  reminder       EventReminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime          @db.Date // occurrence cụ thể của recurring event
  sentAt         DateTime          @default(now())
  channels       ReminderChannel[]

  @@unique([reminderId, occurrenceDate])
  @@index([reminderId])
  @@index([sentAt]) // cho prune cron daily 02:00 (Eng audit #10)
  @@map("event_reminder_dispatches")
}

// ─────────────────────────────────────────────
// Document Number Engine (v0.42)
// Odoo-style configurable document number sequences with row-level lock safety.
// ─────────────────────────────────────────────

model DocumentNumberTemplate {
  id            String   @id @default(uuid())
  name          String   // "Mã vụ việc", "Số tiếp nhận đơn thư", ...
  documentType  String   // "INCIDENT" | "PETITION" | "CASE" | "PROPOSAL" | "DELEGATION" | "EVIDENCE"
  isActive      Boolean  @default(true)
  separator     String   @default("-") // "" = không phân cách
  inputMode     String   @default("AUTO") // "AUTO" | "MANUAL" | "AUTO_WITH_OVERRIDE"
  segments      Json     // Segment[] — ordered array of LITERAL | FORMULA | COUNTER
  counterConfig Json     // { resetPeriod, minValue, maxValue, padding }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  counters DocumentNumberCounter[]
  logs     DocumentNumberLog[]

  @@index([documentType])
  @@index([isActive])
  @@map("document_number_templates")
}

model DocumentNumberCounter {
  id           String   @id @default(uuid())
  templateId   String
  template     DocumentNumberTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  periodKey    String   // "2026" | "2026-05" | "2026-W21" | "global"
  currentValue Int      @default(0)
  resetAt      DateTime?
  updatedAt    DateTime @updatedAt

  @@unique([templateId, periodKey])
  @@index([templateId])
  @@map("document_number_counters")
}

model DocumentNumberLog {
  id              String   @id @default(uuid())
  templateId      String
  template        DocumentNumberTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  generatedNumber String
  documentType    String
  documentId      String?  // loose FK — updated after parent document saved
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  isDraft         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([templateId, createdAt])
  @@index([userId])
  @@index([documentId])
  @@map("document_number_logs")
}
