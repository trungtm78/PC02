  PETITION_RECEIVED
  PETITION_DEADLINE_NEAR
  PETITION_OVERDUE
  INCIDENT_DEADLINE_NEAR
  INCIDENT_OVERDUE
  DOCUMENT_UPLOADED
  SYSTEM
  // Deadline Rule Versioning workflow
  DEADLINE_RULE_SUBMITTED
  DEADLINE_RULE_APPROVED
  DEADLINE_RULE_REJECTED
  DEADLINE_RULE_ACTIVATED
  DEADLINE_RULE_STALE_REVIEW
  DEADLINE_RULE_WITHDRAWN
  DEADLINE_RULE_CHANGES_REQUESTED
  // Notification Center v2 — assignment events
  INCIDENT_ASSIGNED
  PETITION_ASSIGNED
  UTDT_ASSIGNED
  INCIDENT_CREATED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String? // optional deep-link URL
  metadata  Json? // extra context (caseId, petitionId, etc.)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  // Notification Center v2 — acknowledge + push delivery tracking
  acknowledgedAt  DateTime? // set when user clicks the notification link
  pushSentAt      DateTime? // timestamp of most recent FCM send
  pushRetryCount  Int       @default(0)
  pushNextRetryAt DateTime? // null = no retry needed (acked or exhausted)
  pushMaxRetries  Int       @default(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([pushNextRetryAt]) // scheduler query: WHERE pushNextRetryAt <= now
  @@index([acknowledgedAt])
  @@map("notifications")
}

