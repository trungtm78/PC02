{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.stryker.config.js"
  },
  "mutate": [
    "src/legacy-migration/legacy-mapper.ts",
    "src/legacy-migration/migration-report.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "concurrency": 4,
  "timeoutMS": 60000,
  "coverageAnalysis": "perTest",
  "disableTypeChecks": "src/legacy-migration/*.ts",
  "thresholds": { "high": 85, "low": 70, "break": 60 }
}
