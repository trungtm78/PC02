{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "ocr-import/pdf/pdf-worker.js",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "../templates/xlsx/*.xlsx",
        "outDir": "dist/templates",
        "watchAssets": true
      },
      {
        "include": "../templates/xlsx/monthly-reports/**/*.xlsx",
        "outDir": "dist/templates",
        "watchAssets": true
      }
    ]
  }
}
