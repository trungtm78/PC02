{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.stryker.scope.config.js" },
  "mutate": ["src/common/utils/scope-filter.util.ts"],
  "reporters": ["clear-text", "progress"],
  "concurrency": 4,
  "timeoutMS": 60000,
  "coverageAnalysis": "perTest",
  "disableTypeChecks": "src/common/utils/*.ts",
  "thresholds": { "high": 85, "low": 70, "break": 60 }
}
