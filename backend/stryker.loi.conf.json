{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.stryker-loi.config.js" },
  "mutate": [
    "src/common/utils/scope-filter.util.ts",
    "src/document-numbers/document-numbers.service.ts",
    "src/kpi/kpi.service.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation-loi.json" },
  "concurrency": 4,
  "timeoutMS": 90000,
  "coverageAnalysis": "perTest",
  "disableTypeChecks": true,
  "thresholds": { "high": 85, "low": 70, "break": null }
}
