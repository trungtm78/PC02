# UAT / E2E environment — copy to tests/.env.test and fill in.
#
# tests/.env.test is gitignored. Nothing in this suite has a built-in default
# any more: it used to fall back to the production IP with passwords baked into
# the source, which meant an empty environment aimed the whole suite at the live
# system.
#
# IMPORTANT: UAT_PROD must be set in the SHELL, not in this file.
# playwright.config.ts reads it to decide whether to load this file at all, so
# a UAT_PROD line in here is read after the decision has already been made and
# has no effect:
#
#   UAT_PROD=1 npx playwright test --project=api
#
# With UAT_PROD unset, Playwright starts the local backend and frontend itself
# and this file is not loaded.

# Target deployment. Required by tests/uat-auto/_helpers.ts.
#   local dev  : http://localhost:3000
#   staging/prod: http://<host>
BASE_URL=http://localhost:3000

# ── Accounts ────────────────────────────────────────────────────────────────
# Only ADMIN_* is required. Accounts left blank are skipped by global-setup
# instead of being attempted with a guessed password.

ADMIN_USERNAME=
ADMIN_PASSWORD=

ADMIN2_USERNAME=
ADMIN2_PASSWORD=

OFFICER1_USERNAME=
OFFICER1_PASSWORD=

OFFICER2_USERNAME=
OFFICER2_PASSWORD=

APPROVER1_USERNAME=
APPROVER1_PASSWORD=
