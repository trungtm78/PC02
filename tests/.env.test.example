# UAT / E2E environment — copy to tests/.env.test and fill in.
#
# tests/.env.test is gitignored. Nothing in this suite has a built-in default
# any more: it used to fall back to the production IP with passwords baked into
# the source, which meant an empty environment aimed the whole suite at the live
# system.
#
# playwright.config.ts loads tests/.env.test only when UAT_PROD=1.

# Target deployment. Required by tests/uat-auto/_helpers.ts.
#   local dev  : http://localhost:3000
#   staging/prod: http://<host>
BASE_URL=http://localhost:3000

# Set to 1 to run against a deployed environment (loads this file, skips the
# local webServer that playwright.config.ts otherwise starts).
UAT_PROD=1

# ── Accounts ────────────────────────────────────────────────────────────────
# Only ADMIN_* is required. Accounts left blank are skipped by global-setup
# instead of being attempted with a guessed password.

ADMIN_USERNAME=
ADMIN_PASSWORD=

ADMIN2_USERNAME=
ADMIN2_PASSWORD=

OFFICER1_USERNAME=
OFFICER1_PASSWORD=

OFFICER2_USERNAME=
OFFICER2_PASSWORD=

APPROVER1_USERNAME=
APPROVER1_PASSWORD=
